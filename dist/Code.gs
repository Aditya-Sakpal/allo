// ===== 01_Util.js =====
/**
 * 01_Util — small pure helpers (dates, strings, validation). No Apps Script services here.
 * All Date maths uses the script's local time zone (Asia/Kolkata, pinned in appsscript.json).
 */

const DOW_NAMES = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
const MONTH_NAMES = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

/** Realm-safe Date check (values can come from another JS realm in tests). */
function isDate_(v) {
  return Object.prototype.toString.call(v) === '[object Date]' && !isNaN(v.getTime());
}

function pad2_(n) {
  return (n < 10 ? '0' : '') + n;
}

/** Tokens: yyyy MMM MM dd d EEE HH mm. Patterns must not contain other letters that collide. */
function fmt_(d, pattern) {
  if (!isDate_(d)) return '';
  const map = {
    yyyy: String(d.getFullYear()),
    MMM: MONTH_NAMES[d.getMonth()],
    MM: pad2_(d.getMonth() + 1),
    dd: pad2_(d.getDate()),
    d: String(d.getDate()),
    EEE: DOW_NAMES[d.getDay()],
    HH: pad2_(d.getHours()),
    mm: pad2_(d.getMinutes()),
  };
  return pattern.replace(/yyyy|MMM|MM|dd|EEE|HH|mm|d/g, function (t) { return map[t]; });
}

/** "Mon 16 Nov, 18:00" */
function fmtShort_(d) { return fmt_(d, 'EEE d MMM, HH:mm'); }
/** "Mon 16 Nov 2026, 18:00" */
function fmtLong_(d) { return fmt_(d, 'EEE d MMM yyyy, HH:mm'); }
function ymd_(d) { return fmt_(d, 'yyyyMMdd'); }

function startOfDay_(d) {
  return new Date(d.getFullYear(), d.getMonth(), d.getDate());
}

/** Calendar-day arithmetic that keeps wall-clock time (DST-safe). */
function addDays_(d, n) {
  return new Date(d.getFullYear(), d.getMonth(), d.getDate() + n, d.getHours(), d.getMinutes(), d.getSeconds());
}

function addMinutes_(d, n) {
  return new Date(d.getTime() + n * 60000);
}

function sameDay_(a, b) {
  return isDate_(a) && isDate_(b) && a.getFullYear() === b.getFullYear() &&
    a.getMonth() === b.getMonth() && a.getDate() === b.getDate();
}

function atTime_(d, hm) {
  return new Date(d.getFullYear(), d.getMonth(), d.getDate(), hm.h, hm.m, 0, 0);
}

/** "18:00" → {h:18, m:0}; anything else → null. */
function parseHM_(s) {
  const m = String(s == null ? '' : s).trim().match(/^(\d{1,2}):(\d{2})$/);
  if (!m) return null;
  const h = Number(m[1]);
  const mi = Number(m[2]);
  if (h > 23 || mi > 59) return null;
  return { h: h, m: mi };
}

/** Accepts a Date, "YYYY-MM-DD", "YYYY-MM-DD HH:mm[:ss]" or "YYYY-MM-DDTHH:mm". Rejects impossible dates. */
function parseDateTime_(v) {
  if (isDate_(v)) return new Date(v.getTime());
  const s = String(v == null ? '' : v).trim();
  if (!s) return null;
  const m = s.match(/^(\d{4})-(\d{1,2})-(\d{1,2})(?:[ T](\d{1,2}):(\d{2})(?::(\d{2}))?)?$/);
  if (!m) return null;
  const y = Number(m[1]);
  const mo = Number(m[2]) - 1;
  const da = Number(m[3]);
  const h = m[4] ? Number(m[4]) : 0;
  const mi = m[5] ? Number(m[5]) : 0;
  const se = m[6] ? Number(m[6]) : 0;
  if (h > 23 || mi > 59 || se > 59) return null;
  const d = new Date(y, mo, da, h, mi, se);
  if (d.getFullYear() !== y || d.getMonth() !== mo || d.getDate() !== da) return null;
  return d;
}

function toBool_(v) {
  if (v === true) return true;
  const s = String(v == null ? '' : v).trim().toLowerCase();
  return s === 'true' || s === 'yes' || s === 'y' || s === '1';
}

/** 0 → "0m", 135 min → "2h 15m", 2 days → "2d 0h". */
function durationText_(ms) {
  const mins = Math.floor(Math.abs(ms) / 60000);
  const d = Math.floor(mins / 1440);
  const h = Math.floor((mins % 1440) / 60);
  const m = mins % 60;
  if (d) return d + 'd ' + h + 'h';
  if (h) return h + 'h ' + m + 'm';
  return m + 'm';
}

function escapeHtml_(s) {
  return String(s == null ? '' : s)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}

function truncate_(s, n) {
  s = String(s == null ? '' : s);
  return s.length > n ? s.slice(0, n - 1) + '…' : s;
}

function normalizeSpace_(s) {
  return String(s == null ? '' : s).replace(/\s+/g, ' ').trim();
}

function isEmail_(s) {
  return /^[^\s@,;<>]+@[^\s@,;<>]+\.[^\s@,;<>]+$/.test(String(s == null ? '' : s).trim());
}

function splitEmails_(s) {
  return String(s == null ? '' : s).split(/[,;\s]+/).map(function (x) { return x.trim(); }).filter(Boolean);
}

function uniq_(arr) {
  const seen = {};
  return arr.filter(function (x) { if (seen[x]) return false; seen[x] = true; return true; });
}

function sanitizeSheetName_(s) {
  return String(s).replace(/[\[\]*?\/\\:]/g, '-').slice(0, 90);
}

function byDue_(a, b) {
  return a.dueAt.getTime() - b.dueAt.getTime();
}


// ===== 02_Config.js =====
/**
 * 02_Config — typed configuration with validation, the mailer, and the execution context.
 * Bad values never crash the engine: they fall back to defaults and are reported as warnings.
 */

/** [key, default, description] */
const CONFIG_SPEC = [
  ['MANAGER_EMAIL', 'manager@example.com', 'Default manager who receives the same-day pending alert (a Team row can override it).'],
  ['LEADERSHIP_EMAILS', 'leadership@example.com', 'Comma-separated leadership recipients for escalations.'],
  ['EMAIL_MODE', 'LOG_ONLY', 'LIVE = send real emails. LOG_ONLY = only write them to the Email Log (safe for demos).'],
  ['WORKING_DAYS', 'Mon,Tue,Wed,Thu,Fri,Sat', 'Days on which daily tasks run and SLA deadlines count.'],
  ['HOLIDAYS', '', 'Comma-separated YYYY-MM-DD dates treated as non-working (no daily task, SLA clock paused), e.g. 2026-12-25, 2027-01-26.'],
  ['DEFAULT_DUE_TIME', '18:00', 'Cut-off time (HH:mm) for tasks without their own Due Time.'],
  ['REMINDER_LEAD_MINUTES', '120', 'One reminder to the employee this many minutes before the cut-off. 0 = off.'],
  ['MANAGER_ALERT_GRACE_MINUTES', '30', 'Manager is alerted this many minutes after the cut-off (same day).'],
  ['ACK_DEADLINE_TIME', '11:00', 'Manager must acknowledge by this time on the NEXT working day, otherwise leadership is informed.'],
  ['RESOLVE_GRACE_WORKING_DAYS', '1', 'Working days after the cut-off by which the task must be done, otherwise leadership is informed.'],
  ['TICKET_ID_PATTERN', '^(?=.*[0-9])[A-Za-z0-9][A-Za-z0-9#/_.-]{2,39}$', 'Regular expression a Ticket ID must match.'],
  ['DAILY_UPDATE_MIN_CHARS', '20', 'Minimum length of the daily update text.'],
  ['RECENT_DAYS', '7', 'Days of history shown on the views.'],
  ['SIMULATED_NOW', '', 'DEMO ONLY: pretend the time is this (YYYY-MM-DD HH:mm). Leave BLANK in production.'],
  ['WEBAPP_URL', '', 'Web-app URL used for one-click Acknowledge links (auto-detected once deployed).'],
];

function configSpecByKey_() {
  const o = {};
  CONFIG_SPEC.forEach(function (s) { o[s[0]] = s; });
  return o;
}

function readConfigRaw_(ss) {
  const sh = ss.getSheetByName(SHEETS.CONFIG);
  const raw = {};
  if (!sh || sh.getLastRow() < 2) return raw;
  const vals = sh.getRange(2, 1, sh.getLastRow() - 1, 2).getDisplayValues();
  vals.forEach(function (r) {
    const k = String(r[0]).trim();
    if (k) raw[k] = String(r[1]);
  });
  return raw;
}

function readConfig_(ss) {
  return parseConfig_(readConfigRaw_(ss));
}

function parseWorkingDays_(s) {
  const tokens = String(s == null ? '' : s).split(/[,\s]+/).filter(Boolean);
  if (!tokens.length) return null;
  const set = new Set();
  for (let i = 0; i < tokens.length; i++) {
    const t = tokens[i].slice(0, 3).toLowerCase();
    const idx = DOW_NAMES.findIndex(function (d) { return d.toLowerCase() === t; });
    if (idx < 0) return null;
    set.add(idx);
  }
  return set;
}

/** raw: {KEY: string}. Returns a typed cfg with cfg.errors (human-readable warnings). */
function parseConfig_(raw) {
  const spec = configSpecByKey_();
  const errors = [];
  const val = function (key) {
    const v = raw[key];
    return v === undefined || v === null ? String(spec[key][1]) : String(v).trim();
  };
  const def = function (key) { return String(spec[key][1]); };
  const intOr = function (key, min, max) {
    const s = val(key);
    const n = Number(s);
    if (s === '' || !isFinite(n) || Math.floor(n) !== n || n < min || n > max) {
      errors.push(key + ' "' + s + '" must be a whole number between ' + min + ' and ' + max + ' — using ' + def(key));
      return Number(def(key));
    }
    return n;
  };
  const timeOr = function (key) {
    const hm = parseHM_(val(key));
    if (!hm) {
      errors.push(key + ' "' + val(key) + '" must be HH:mm — using ' + def(key));
      return parseHM_(def(key));
    }
    return hm;
  };

  const cfg = { errors: errors, raw: raw };

  cfg.managerEmail = val('MANAGER_EMAIL').toLowerCase();
  if (!isEmail_(cfg.managerEmail)) {
    errors.push('MANAGER_EMAIL "' + cfg.managerEmail + '" is not a valid email — manager alerts cannot be sent');
    cfg.managerEmail = '';
  }

  const lead = splitEmails_(val('LEADERSHIP_EMAILS')).map(function (e) { return e.toLowerCase(); });
  const badLead = lead.filter(function (e) { return !isEmail_(e); });
  if (badLead.length) errors.push('LEADERSHIP_EMAILS has invalid address(es): ' + badLead.join(', '));
  cfg.leadershipEmails = uniq_(lead.filter(isEmail_));
  if (!cfg.leadershipEmails.length) errors.push('LEADERSHIP_EMAILS is empty — escalations cannot be sent');

  const mode = val('EMAIL_MODE').toUpperCase();
  if (mode === 'LIVE' || mode === 'LOG_ONLY') {
    cfg.emailMode = mode;
  } else {
    errors.push('EMAIL_MODE "' + mode + '" must be LIVE or LOG_ONLY — using LOG_ONLY');
    cfg.emailMode = 'LOG_ONLY';
  }

  cfg.workingDays = parseWorkingDays_(val('WORKING_DAYS'));
  if (!cfg.workingDays) {
    errors.push('WORKING_DAYS "' + val('WORKING_DAYS') + '" not understood (use e.g. Mon,Tue,Wed,Thu,Fri) — using ' + def('WORKING_DAYS'));
    cfg.workingDays = parseWorkingDays_(def('WORKING_DAYS'));
  }

  cfg.holidays = new Set();
  const badHolidays = [];
  splitEmails_(val('HOLIDAYS')).forEach(function (s) {
    const d = /^\d{4}-\d{1,2}-\d{1,2}$/.test(s) ? parseDateTime_(s) : null;
    if (d) cfg.holidays.add(ymd_(d));
    else badHolidays.push(s);
  });
  if (badHolidays.length) errors.push('HOLIDAYS has invalid date(s) (use YYYY-MM-DD): ' + badHolidays.join(', '));

  cfg.defaultDueHM = timeOr('DEFAULT_DUE_TIME');
  cfg.reminderLeadMin = intOr('REMINDER_LEAD_MINUTES', 0, 1440);
  cfg.graceMin = intOr('MANAGER_ALERT_GRACE_MINUTES', 0, 720);
  cfg.ackHM = timeOr('ACK_DEADLINE_TIME');
  cfg.resolveGraceDays = intOr('RESOLVE_GRACE_WORKING_DAYS', 0, 30);
  cfg.dailyMinChars = intOr('DAILY_UPDATE_MIN_CHARS', 1, 1000);
  cfg.recentDays = intOr('RECENT_DAYS', 1, 90);

  try {
    cfg.ticketRe = new RegExp(val('TICKET_ID_PATTERN'));
  } catch (e) {
    errors.push('TICKET_ID_PATTERN is not a valid regular expression — using the default');
    cfg.ticketRe = new RegExp(def('TICKET_ID_PATTERN'));
  }

  const simRaw = val('SIMULATED_NOW');
  cfg.simulatedNow = null;
  if (simRaw) {
    cfg.simulatedNow = parseDateTime_(simRaw);
    if (!cfg.simulatedNow) errors.push('SIMULATED_NOW "' + simRaw + '" must be YYYY-MM-DD HH:mm — using real time');
  }

  cfg.webAppUrl = val('WEBAPP_URL');
  if (cfg.webAppUrl && !/^https:\/\//.test(cfg.webAppUrl)) {
    errors.push('WEBAPP_URL must start with https:// — acknowledgement links disabled');
    cfg.webAppUrl = '';
  }
  return cfg;
}

/** LIVE → MailApp; LOG_ONLY → nothing leaves the sheet. Tests inject their own capture mailer. */
function makeMailer_(cfg) {
  if (cfg.emailMode === 'LIVE') {
    return {
      mode: 'LIVE',
      send: function (msg) {
        const needed = splitEmails_(msg.to).length + splitEmails_(msg.cc).length;
        const left = MailApp.getRemainingDailyQuota();
        if (left < needed) throw new Error('Daily email quota exhausted (' + left + ' left, ' + needed + ' needed)');
        const opts = { to: msg.to, subject: msg.subject, htmlBody: msg.htmlBody, body: msg.body, name: APP_NAME };
        if (msg.cc) opts.cc = msg.cc;
        MailApp.sendEmail(opts);
        return { delivery: 'SENT' };
      },
    };
  }
  return { mode: 'LOG_ONLY', send: function () { return { delivery: 'LOG_ONLY' }; } };
}

/**
 * The execution context every core function receives.
 * opts: { cfg?, now?: () => Date, mailer?, webAppUrl? }
 */
function makeContext_(ss, opts) {
  opts = opts || {};
  const cfg = opts.cfg || readConfig_(ss);
  const now = opts.now || function () {
    return cfg.simulatedNow ? new Date(cfg.simulatedNow.getTime()) : new Date();
  };
  return {
    ss: ss,
    cfg: cfg,
    now: now,
    mailer: opts.mailer || makeMailer_(cfg),
    webAppUrl: opts.webAppUrl || '',
  };
}


// ===== 03_Schedule.js =====
/**
 * 03_Schedule — slot maths, working days and SLA deadlines. Pure functions of (date, cfg).
 * Spec: specs/features/F01-recurring-cycle-engine.md, F07-notifications-sla-escalation.md
 */

/** "Daily" | "Every N days" | "N" | "Weekly" | "Monthly" → {kind, days, label} or null. */
function parseFrequency_(s) {
  const t = normalizeSpace_(s).toLowerCase();
  if (!t) return null;
  const daily = { kind: 'DAILY', days: 1, label: 'Daily' };
  if (t === 'daily' || t === 'every day') return daily;
  if (t === 'weekly') return { kind: 'INTERVAL', days: 7, label: 'Every 7 days' };
  if (t === 'fortnightly') return { kind: 'INTERVAL', days: 14, label: 'Every 14 days' };
  if (t === 'monthly') return { kind: 'INTERVAL', days: 30, label: 'Every 30 days' };
  const m = t.match(/^(?:every\s+)?(\d{1,3})(?:\s*days?)?$/);
  if (!m) return null;
  const n = Number(m[1]);
  if (n < 1 || n > 366) return null;
  if (n === 1) return daily;
  return { kind: 'INTERVAL', days: n, label: 'Every ' + n + ' days' };
}

function isWorkingDay_(d, cfg) {
  return cfg.workingDays.has(d.getDay()) && !(cfg.holidays && cfg.holidays.has(ymd_(d)));
}

/** The same day if it is a working day, otherwise the next working day (date only). */
function onOrNextWorkingDay_(d, cfg) {
  let x = startOfDay_(d);
  // 60 days covers any realistic run of weekends + holidays; the cap prevents an infinite loop
  // if someone lists every day of a month as a holiday.
  for (let i = 0; i < 60 && !isWorkingDay_(x, cfg); i++) x = addDays_(x, 1);
  return x;
}

/** The first working day strictly after d's date. */
function nextWorkingDay_(d, cfg) {
  return onOrNextWorkingDay_(addDays_(startOfDay_(d), 1), cfg);
}

function addWorkingDays_(d, n, cfg) {
  let x = startOfDay_(d);
  for (let i = 0; i < n; i++) x = nextWorkingDay_(x, cfg);
  return x;
}

function cycleId_(taskId, slot) {
  return taskId + '-' + ymd_(slot);
}

/** Interval slots falling on a non-working day are due on the next working day. The anchor does not move. */
function slotDueAt_(slot, freq, dueHM, cfg) {
  const day = freq.kind === 'DAILY' ? startOfDay_(slot) : onOrNextWorkingDay_(slot, cfg);
  return atTime_(day, dueHM);
}

function nextSlot_(slot, freq, cfg) {
  return freq.kind === 'DAILY' ? nextWorkingDay_(slot, cfg) : addDays_(startOfDay_(slot), freq.days);
}

/** Daily: from 00:00 of the day. Interval: from the previous slot's cut-off. */
function windowOpensAt_(slot, freq, dueHM, cfg) {
  if (freq.kind === 'DAILY') return startOfDay_(slot);
  return slotDueAt_(addDays_(startOfDay_(slot), -freq.days), freq, dueHM, cfg);
}

/** Manager must acknowledge by ACK_DEADLINE_TIME on the working day after the alert. */
function ackDeadline_(alertAt, cfg) {
  return atTime_(nextWorkingDay_(alertAt, cfg), cfg.ackHM);
}

/** Task must be done by its own cut-off time, RESOLVE_GRACE_WORKING_DAYS working days after the due date. */
function resolveDeadline_(dueAt, cfg) {
  return atTime_(addWorkingDays_(dueAt, cfg.resolveGraceDays, cfg), { h: dueAt.getHours(), m: dueAt.getMinutes() });
}

function managerAlertAt_(dueAt, cfg) {
  return addMinutes_(dueAt, cfg.graceMin);
}

function reminderAt_(dueAt, cfg) {
  return addMinutes_(dueAt, -cfg.reminderLeadMin);
}


// ===== 04_Store.js =====
/**
 * 04_Store — table I/O (by header name, batched) and the in-memory model.
 * The Cycles sheet is the ledger and the single source of truth; everything else is derived.
 */

function requireSheet_(ss, name) {
  const sh = ss.getSheetByName(name);
  if (!sh) throw new Error('Sheet "' + name + '" is missing. Run ⚙️ Task System → Admin → Setup / repair sheets.');
  return sh;
}

/** Grow the sheet so rows 1..n exist (getRange beyond max rows throws in Apps Script). */
function ensureRows_(sh, n) {
  const max = sh.getMaxRows();
  if (max < n) sh.insertRowsAfter(max, n - max);
}

function ensureCols_(sh, n) {
  const max = sh.getMaxColumns();
  if (max < n) sh.insertColumnsAfter(max, n - max);
}

/**
 * Reads a header-row table. Rows that are entirely empty (or only unticked checkboxes) are skipped.
 * Each row object: {_row, <key>: raw value, _d: {<key>: display value}}.
 */
function readTable_(sheet, fields) {
  const res = { rows: [], missing: [], idx: {}, lastRow: sheet.getLastRow() };
  const lastRow = res.lastRow;
  const lastCol = sheet.getLastColumn();
  if (lastRow < 1 || lastCol < 1) {
    res.missing = fields.map(function (f) { return f[1]; });
    return res;
  }
  const rng = sheet.getRange(1, 1, lastRow, lastCol);
  const vals = rng.getValues();
  const disp = rng.getDisplayValues();
  const header = vals[0].map(function (h) { return String(h).trim(); });
  fields.forEach(function (f) {
    const i = header.indexOf(f[1]);
    if (i < 0) res.missing.push(f[1]);
    else res.idx[f[0]] = i;
  });
  for (let r = 1; r < vals.length; r++) {
    const row = vals[r];
    const empty = row.every(function (v) { return v === '' || v === null || v === false; });
    if (empty) continue;
    const o = { _row: r + 1, _d: {} };
    fields.forEach(function (f) {
      const i = res.idx[f[0]];
      o[f[0]] = i === undefined ? '' : row[i];
      o._d[f[0]] = i === undefined ? '' : disp[r][i];
    });
    res.rows.push(o);
  }
  return res;
}

function appendRows_(sh, rows, width) {
  if (!rows.length) return;
  const start = sh.getLastRow() + 1;
  ensureRows_(sh, start + rows.length - 1);
  const data = rows.map(function (r) {
    const out = [];
    for (let i = 0; i < width; i++) out.push(r[i] === undefined || r[i] === null ? '' : r[i]);
    return out;
  });
  sh.getRange(start, 1, data.length, width).setValues(data);
}

function toDateOrNull_(v) {
  if (isDate_(v)) return v;
  if (v === '' || v === null || v === undefined) return null;
  return parseDateTime_(v);
}

function normalizeCycle_(r) {
  const s = function (v) { return v === null || v === undefined ? '' : String(v).trim(); };
  const c = { _row: r._row };
  CYCLE_FIELDS.forEach(function (f) {
    const k = f[0];
    c[k] = CYCLE_DATE_KEYS.indexOf(k) >= 0 ? toDateOrNull_(r[k]) : s(r[k]);
  });
  c.status = c.status.toUpperCase();
  c.proof = r.proof === null || r.proof === undefined ? '' : String(r.proof).trim();
  const okStatus = Object.keys(STATUS).some(function (k) { return STATUS[k] === c.status; });
  if (!c.id || !c.taskId || !c.slot || !c.dueAt || !c.opensAt || !okStatus) {
    // Keep the row exactly as found so a manual mistake is never destroyed by a rewrite.
    c._bad = true;
    c._orig = {};
    CYCLE_FIELDS.forEach(function (f) { c._orig[f[0]] = r[f[0]] === undefined ? '' : r[f[0]]; });
  }
  return c;
}

function cycleToRow_(c) {
  if (c._bad) return CYCLE_FIELDS.map(function (f) { return c._orig[f[0]]; });
  return CYCLE_FIELDS.map(function (f) {
    const v = c[f[0]];
    return v === null || v === undefined ? '' : v;
  });
}

function log_(m, event, cycleId, actor, details) {
  m.logs.push([m.now, event, cycleId || '', actor || 'system', details || '']);
}

/** Loads Team, Tasks and Cycles into a model. Validation of tasks happens in 05_Cycles. */
function loadModel_(ctx) {
  const ss = ctx.ss;
  const cfg = ctx.cfg;
  const m = {
    now: ctx.now(),
    cfg: cfg,
    logs: [],
    warnings: cfg.errors.map(function (e) { return 'Config: ' + e; }),
    healthComputed: false,
  };

  const teamT = readTable_(requireSheet_(ss, SHEETS.TEAM), TEAM_FIELDS);
  if (teamT.missing.indexOf('Employee') >= 0) throw new Error('Team sheet has no "Employee" column. Run Setup.');
  m.team = [];
  m.teamByName = {};
  teamT.rows.forEach(function (r) {
    const name = normalizeSpace_(r._d.name);
    if (!name) return;
    if (m.teamByName[name]) { m.warnings.push('Team: "' + name + '" is listed twice — row ' + r._row + ' ignored'); return; }
    const e = {
      _row: r._row,
      name: name,
      email: String(r._d.email || '').trim().toLowerCase(),
      managerEmail: String(r._d.managerEmail || '').trim().toLowerCase(),
      active: teamT.idx.active === undefined ? true : toBool_(r.active),
    };
    if (e.email && !isEmail_(e.email)) { m.warnings.push('Team: email for ' + name + ' is invalid'); e.email = ''; }
    if (e.managerEmail && !isEmail_(e.managerEmail)) { m.warnings.push('Team: manager email for ' + name + ' is invalid — using default manager'); e.managerEmail = ''; }
    m.team.push(e);
    m.teamByName[name] = e;
  });

  const taskT = readTable_(requireSheet_(ss, SHEETS.TASKS), TASK_FIELDS);
  const reqTask = ['Task ID', 'Task Name', 'Assigned To', 'Frequency', 'Proof Type', 'First Due Date'];
  const missingTask = reqTask.filter(function (h) { return taskT.missing.indexOf(h) >= 0; });
  if (missingTask.length) throw new Error('Tasks sheet is missing column(s): ' + missingTask.join(', ') + '. Run Setup.');
  m.taskIdx = taskT.idx;
  m.taskLastRow = taskT.lastRow;
  m.tasks = taskT.rows.map(function (r) {
    return {
      _row: r._row,
      id: normalizeSpace_(r._d.id),
      name: normalizeSpace_(r._d.name),
      assignedTo: normalizeSpace_(r._d.assignedTo),
      frequency: normalizeSpace_(r._d.frequency),
      proofType: normalizeSpace_(r._d.proofType),
      instructions: String(r._d.instructions || '').trim(),
      dueTimeRaw: String(r._d.dueTime || '').trim(),
      firstDueRaw: r.firstDue,
      firstDueDisp: String(r._d.firstDue || '').trim(),
      active: taskT.idx.active === undefined ? true : toBool_(r.active),
    };
  });

  const cycT = readTable_(requireSheet_(ss, SHEETS.CYCLES), CYCLE_FIELDS);
  if (cycT.missing.length && cycT.lastRow > 1) {
    throw new Error('Cycles sheet is missing column(s): ' + cycT.missing.join(', ') + '. Run Setup.');
  }
  m.cycles = [];
  m.byId = {};
  cycT.rows.forEach(function (r) {
    const c = normalizeCycle_(r);
    if (c._bad) {
      m.warnings.push('Cycles row ' + r._row + ' is incomplete or has an unknown status — it is kept but ignored');
    } else if (m.byId[c.id]) {
      c._bad = true;
      c._orig = {};
      CYCLE_FIELDS.forEach(function (f) { c._orig[f[0]] = r[f[0]] === undefined ? '' : r[f[0]]; });
      m.warnings.push('Cycles row ' + r._row + ' duplicates Cycle ID ' + c.id + ' — it is kept but ignored');
    } else {
      m.byId[c.id] = c;
    }
    m.cycles.push(c);
  });

  validateTasks_(m);
  return m;
}

/** Active (non-corrupt) cycles only. */
function liveCycles_(m) {
  return m.cycles.filter(function (c) { return !c._bad; });
}

function saveCycles_(ctx, m) {
  const sh = requireSheet_(ctx.ss, SHEETS.CYCLES);
  const rows = [CYCLE_FIELDS.map(function (f) { return f[1]; })].concat(m.cycles.map(cycleToRow_));
  ensureRows_(sh, rows.length);
  ensureCols_(sh, CYCLE_FIELDS.length);
  sh.getRange(1, 1, rows.length, CYCLE_FIELDS.length).setValues(rows);
  const last = sh.getLastRow();
  if (last > rows.length) {
    sh.getRange(rows.length + 1, 1, last - rows.length, Math.max(sh.getLastColumn(), CYCLE_FIELDS.length)).clearContent();
  }
}

function flushLogs_(ctx, m) {
  if (!m.logs.length) return;
  appendRows_(requireSheet_(ctx.ss, SHEETS.LOG), m.logs, LOG_HEADERS.length);
  m.logs = [];
}

function appendEmailLog_(ctx, row) {
  appendRows_(requireSheet_(ctx.ss, SHEETS.EMAILS), [row], EMAIL_HEADERS.length);
}

function writeTaskHealth_(ctx, m) {
  if (!m.healthComputed || m.taskIdx.health === undefined || m.taskLastRow < 2) return;
  const sh = requireSheet_(ctx.ss, SHEETS.TASKS);
  const vals = [];
  for (let r = 2; r <= m.taskLastRow; r++) vals.push(['']);
  m.tasks.forEach(function (t) { vals[t._row - 2] = [t.health || '']; });
  sh.getRange(2, m.taskIdx.health + 1, vals.length, 1).setValues(vals);
}

function saveModel_(ctx, m) {
  saveCycles_(ctx, m);
  writeTaskHealth_(ctx, m);
  flushLogs_(ctx, m);
}

function managerFor_(m, employeeName) {
  const e = m.teamByName[employeeName];
  return (e && e.managerEmail) || m.cfg.managerEmail || '';
}


// ===== 05_Cycles.js =====
/**
 * 05_Cycles — cycle lifecycle: task validation, cycle creation, completion, acknowledgement, waive.
 * Spec: F01 (engine), F03 (ticket), F04 (daily), F05 (tracking), F06 (ack / waive).
 * Every function here mutates the in-memory model only; callers persist with saveModel_.
 */

const MAX_PROOF_CHARS = 4000;
const MAX_SKIPPED_ROWS = 60;

function statusLabel_(s) {
  return {
    OPEN: 'Open', DONE: 'Done on time', LATE_DONE: 'Done late', SKIPPED: 'Skipped (missed)', WAIVED: 'Waived',
  }[s] || s;
}

function validateTasks_(m) {
  const seen = {};
  m.taskById = {};
  m.tasks.forEach(function (t) {
    const errs = [];
    if (!t.id) errs.push('Task ID is blank');
    else if (!/^[A-Za-z0-9_.-]{1,30}$/.test(t.id)) errs.push('Task ID may only use letters, digits, - _ . (max 30)');
    else if (seen[t.id]) errs.push('Duplicate Task ID (first used on row ' + seen[t.id] + ')');
    if (t.id && !seen[t.id]) seen[t.id] = t._row;
    if (!t.name) errs.push('Task Name is blank');
    const emp = m.teamByName[t.assignedTo];
    if (!t.assignedTo) errs.push('Assigned To is blank');
    else if (!emp) errs.push('"' + t.assignedTo + '" is not on the Team sheet');
    else if (!emp.active) errs.push(t.assignedTo + ' is inactive — reassign this task');
    t.freq = parseFrequency_(t.frequency);
    if (!t.freq) errs.push('Frequency "' + t.frequency + '" not understood (use Daily or Every N days)');
    if (t.proofType !== PROOF.TICKET && t.proofType !== PROOF.DAILY) errs.push('Proof Type must be "Ticket ID" or "Daily Update"');
    t.dueHM = t.dueTimeRaw ? parseHM_(t.dueTimeRaw) : m.cfg.defaultDueHM;
    if (!t.dueHM) errs.push('Due Time "' + t.dueTimeRaw + '" must be HH:mm');
    const fd = isDate_(t.firstDueRaw) ? t.firstDueRaw : parseDateTime_(t.firstDueDisp);
    t.firstDue = fd ? startOfDay_(fd) : null;
    if (!t.firstDue) errs.push('First Due Date missing or invalid (use YYYY-MM-DD)');
    t.errors = errs;
    t.valid = errs.length === 0;
    // The engine runs every 15 minutes, so the alert can only be guaranteed the same day
    // if cut-off + grace is at or before 23:44.
    t.note = '';
    if (t.dueHM && t.dueHM.h * 60 + t.dueHM.m + m.cfg.graceMin > 23 * 60 + 44) {
      t.note = ' · ⚠️ cut-off is so late that the manager alert may arrive after midnight';
    }
    if (t.id && !m.taskById[t.id]) m.taskById[t.id] = t;
  });
}

function cyclesOfTask_(m, taskId) {
  return liveCycles_(m).filter(function (c) { return c.taskId === taskId; });
}

function openCyclesOfTask_(m, taskId) {
  return cyclesOfTask_(m, taskId).filter(function (c) { return c.status === STATUS.OPEN; });
}

function newCycle_(m, t, slot, status) {
  const s = startOfDay_(slot);
  return {
    id: cycleId_(t.id, s),
    taskId: t.id,
    taskName: t.name,
    employee: t.assignedTo,
    frequency: t.freq.label,
    proofType: t.proofType,
    slot: s,
    opensAt: windowOpensAt_(s, t.freq, t.dueHM, m.cfg),
    dueAt: slotDueAt_(s, t.freq, t.dueHM, m.cfg),
    status: status,
    completedAt: null, completedBy: '', proof: '',
    reminderAt: null, alertAt: null, ackAt: null, ackBy: '', ackNote: '',
    escalatedAt: null, escalationReason: '', resolvedNoticeAt: null,
    closeNote: '',
    updatedAt: m.now,
  };
}

function addCycle_(m, c, event, details) {
  m.cycles.push(c);
  m.byId[c.id] = c;
  log_(m, event, c.id, 'system', details);
}

function closeCycle_(m, c, status, note, actor) {
  c.status = status;
  c.closeNote = note;
  c.updatedAt = m.now;
  log_(m, status === STATUS.WAIVED ? 'WAIVED' : 'CLOSED', c.id, actor, note);
}

/** Keeps the denormalised copy on OPEN cycles in line with the Task Master. */
function syncCycleFromTask_(m, c, t) {
  if (c.employee !== t.assignedTo) {
    log_(m, 'REASSIGNED', c.id, 'system', c.employee + ' → ' + t.assignedTo);
    c.employee = t.assignedTo;
    c.updatedAt = m.now;
  }
  c.taskName = t.name;
  c.proofType = t.proofType;
}

/** Idempotent: safe to call any number of times. Creates only what is missing. */
function ensureCycles_(m) {
  m.tasks.forEach(function (t) {
    if (!t.id || m.taskById[t.id] !== t) {
      t.health = '⚠️ ' + (t.errors.length ? t.errors.join('; ') : 'Duplicate row');
      return;
    }
    const open = openCyclesOf_(m, t);
    if (!t.active) {
      open.forEach(function (c) { closeCycle_(m, c, STATUS.WAIVED, 'Task deactivated in Tasks sheet', 'system'); });
      t.health = '⏸ Inactive';
      return;
    }
    if (!t.valid) {
      t.health = '⚠️ ' + t.errors.join('; ');
      return;
    }
    open.forEach(function (c) { syncCycleFromTask_(m, c, t); });
    if (t.freq.kind === 'DAILY') ensureDaily_(m, t);
    else ensureInterval_(m, t);
    const nowOpen = openCyclesOf_(m, t).sort(byDue_);
    t.health = nowOpen.length
      ? '✅ OK · open cycle due ' + fmtShort_(nowOpen[0].dueAt) + (nowOpen.length > 1 ? ' (+' + (nowOpen.length - 1) + ' older open)' : '')
      : '✅ OK · next cycle is created automatically';
    t.health += t.note;
  });
  // Open cycles whose task row was deleted would otherwise alert forever.
  liveCycles_(m).forEach(function (c) {
    if (c.status === STATUS.OPEN && !m.taskById[c.taskId]) {
      closeCycle_(m, c, STATUS.WAIVED, 'Task ' + c.taskId + ' no longer exists in the Tasks sheet', 'system');
    }
  });
  m.healthComputed = true;
}

function openCyclesOf_(m, t) {
  return openCyclesOfTask_(m, t.id);
}

function ensureDaily_(m, t) {
  const today = startOfDay_(m.now);
  if (!isWorkingDay_(today, m.cfg)) return;
  if (t.firstDue.getTime() > today.getTime()) return;
  const id = cycleId_(t.id, today);
  if (m.byId[id]) return;
  const history = cyclesOfTask_(m, t.id);
  // A brand-new daily task added after today's cut-off starts tomorrow instead of being born overdue.
  if (!history.length && slotDueAt_(today, t.freq, t.dueHM, m.cfg).getTime() <= m.now.getTime()) return;
  addCycle_(m, newCycle_(m, t, today, STATUS.OPEN), 'CYCLE_CREATED', 'Daily cycle for ' + fmt_(today, 'EEE d MMM'));
}

function ensureInterval_(m, t) {
  if (openCyclesOf_(m, t).length) return;
  const history = cyclesOfTask_(m, t.id);
  let slot;
  if (!history.length) {
    slot = t.firstDue;
  } else {
    const last = history.reduce(function (a, c) { return c.slot.getTime() > a.getTime() ? c.slot : a; }, history[0].slot);
    slot = nextSlot_(last, t.freq, m.cfg);
  }
  let rolled = 0;
  while (slotDueAt_(slot, t.freq, t.dueHM, m.cfg).getTime() <= m.now.getTime() && rolled < 5000) {
    slot = nextSlot_(slot, t.freq, m.cfg);
    rolled++;
  }
  const id = cycleId_(t.id, slot);
  if (m.byId[id]) return;
  addCycle_(m, newCycle_(m, t, slot, STATUS.OPEN), 'CYCLE_CREATED',
    rolled ? 'Scheduled (rolled forward ' + rolled + ' period(s) that had already passed)' : 'Scheduled');
}

/** After an interval cycle closes: record slots that already passed as SKIPPED, open the next future slot. */
function scheduleNextInterval_(m, t, closed) {
  if (openCyclesOf_(m, t).length) return null;
  let slot = nextSlot_(closed.slot, t.freq, m.cfg);
  let skipped = 0;
  let guard = 0;
  while (slotDueAt_(slot, t.freq, t.dueHM, m.cfg).getTime() <= m.now.getTime() && guard++ < 5000) {
    const id = cycleId_(t.id, slot);
    if (!m.byId[id] && skipped < MAX_SKIPPED_ROWS) {
      const s = newCycle_(m, t, slot, STATUS.SKIPPED);
      s.closeNote = 'Cut-off passed while ' + closed.id + ' was still open';
      addCycle_(m, s, 'CYCLE_SKIPPED', s.closeNote);
      skipped++;
    }
    slot = nextSlot_(slot, t.freq, m.cfg);
  }
  const id = cycleId_(t.id, slot);
  if (m.byId[id]) return m.byId[id];
  const n = newCycle_(m, t, slot, STATUS.OPEN);
  addCycle_(m, n, 'CYCLE_CREATED', 'Next cycle after ' + closed.id);
  return n;
}

function validateProof_(m, c, raw) {
  const isDaily = c.proofType === PROOF.DAILY;
  const value = isDaily ? String(raw == null ? '' : raw).trim() : normalizeSpace_(raw);
  if (!value) return { ok: false, code: 'EMPTY', msg: 'Nothing was entered.' };
  if (value.length > MAX_PROOF_CHARS) {
    return { ok: false, code: 'TOO_LONG', msg: 'That is ' + value.length + ' characters — please keep it under ' + MAX_PROOF_CHARS + '.' };
  }
  const others = liveCycles_(m).filter(function (x) { return x !== c && x.proof; });
  if (!isDaily) {
    if (!m.cfg.ticketRe.test(value)) {
      return {
        ok: false, code: 'BAD_TICKET',
        msg: '"' + truncate_(value, 40) + '" is not a valid Ticket ID. Use the portal ticket number, e.g. PRT-10234 (3–40 letters/digits, at least one digit, no spaces).',
      };
    }
    const dup = others.find(function (x) { return x.proofType === PROOF.TICKET && x.proof.toUpperCase() === value.toUpperCase(); });
    if (dup) {
      return {
        ok: false, code: 'DUP_TICKET',
        msg: 'Ticket ' + value + ' was already used for ' + dup.taskName + ' (' + fmt_(dup.slot, 'd MMM') + '). Enter the ticket for this cycle.',
      };
    }
  } else {
    if (value.length < m.cfg.dailyMinChars) {
      return {
        ok: false, code: 'TOO_SHORT',
        msg: 'Paste the actual update you shared (at least ' + m.cfg.dailyMinChars + ' characters). "' + truncate_(value, 30) + '" is too short.',
      };
    }
    const norm = normalizeSpace_(value).toLowerCase();
    const dup = others.find(function (x) { return x.taskId === c.taskId && normalizeSpace_(x.proof).toLowerCase() === norm; });
    if (dup) {
      return {
        ok: false, code: 'DUP_UPDATE',
        msg: 'This is identical to the update for ' + fmt_(dup.slot, 'EEE d MMM') + '. Please paste today\'s update.',
      };
    }
  }
  return { ok: true, value: value };
}

/** Closes an OPEN cycle with proof. Returns {ok, code?, msg, next?}. */
function completeCycle_(m, c, raw, actor) {
  if (!c || c._bad) return { ok: false, code: 'UNKNOWN', msg: 'This row is out of date — the sheet will refresh in a moment.' };
  if (c.status !== STATUS.OPEN) {
    return {
      ok: false, code: 'NOT_OPEN',
      msg: 'Already ' + statusLabel_(c.status).toLowerCase() + (c.completedAt ? ' (' + fmtShort_(c.completedAt) + ')' : '') + ' — nothing to do.',
    };
  }
  if (m.now.getTime() < c.opensAt.getTime()) {
    return { ok: false, code: 'NOT_YET', msg: 'This cycle opens on ' + fmtShort_(c.opensAt) + ' — it cannot be closed early.' };
  }
  const v = validateProof_(m, c, raw);
  if (!v.ok) {
    log_(m, 'PROOF_REJECTED', c.id, actor, v.code + ': ' + truncate_(String(raw == null ? '' : raw), 80));
    return v;
  }
  const late = m.now.getTime() > c.dueAt.getTime();
  c.status = late ? STATUS.LATE : STATUS.DONE;
  c.completedAt = m.now;
  c.completedBy = actor;
  c.proof = v.value;
  c.updatedAt = m.now;
  log_(m, 'COMPLETED', c.id, actor, (late ? 'Late by ' + durationText_(m.now - c.dueAt) + ' · ' : 'On time · ') + truncate_(v.value, 80));

  let next = null;
  const t = m.taskById[c.taskId];
  if (t && t.valid && t.active && t.freq.kind === 'INTERVAL') next = scheduleNextInterval_(m, t, c);
  return {
    ok: true,
    cycle: c,
    next: next,
    msg: (late ? '✅ Recorded (late)' : '✅ Recorded on time') + (next ? ' · next cycle due ' + fmtShort_(next.dueAt) : ''),
  };
}

function canAcknowledge_(m, c) {
  return !!c.alertAt || (c.status === STATUS.OPEN && m.now.getTime() > c.dueAt.getTime());
}

/** Idempotent. A later note updates the note but never moves the original acknowledgement time. */
function ackCycle_(m, c, actor, note) {
  if (!c || c._bad) return { ok: false, msg: 'Unknown task cycle.' };
  note = normalizeSpace_(note).slice(0, 500);
  if (c.ackAt) {
    if (note && note !== c.ackNote) {
      c.ackNote = note;
      c.updatedAt = m.now;
      log_(m, 'ACK_NOTE', c.id, actor, note);
      return { ok: true, already: true, msg: 'Note saved.' };
    }
    return { ok: true, already: true, msg: 'Already acknowledged ' + fmtShort_(c.ackAt) + ' by ' + c.ackBy + '. Nothing changed.' };
  }
  if (!canAcknowledge_(m, c)) return { ok: false, msg: 'Nothing to acknowledge yet — this task is not overdue.' };
  c.ackAt = m.now;
  c.ackBy = actor;
  if (note) c.ackNote = note;
  c.updatedAt = m.now;
  log_(m, 'ACKNOWLEDGED', c.id, actor, 'Task status at acknowledgement: ' + statusLabel_(c.status) + (note ? ' · ' + note : ''));
  return {
    ok: true,
    msg: c.status === STATUS.OPEN
      ? 'Acknowledged. Please make sure it is done by ' + fmtShort_(resolveDeadline_(c.dueAt, m.cfg)) + '.'
      : 'Acknowledged. The task itself is already ' + statusLabel_(c.status).toLowerCase() + '.',
  };
}

function saveNote_(m, c, actor, note) {
  note = normalizeSpace_(note).slice(0, 500);
  if (note === c.ackNote) return false;
  c.ackNote = note;
  c.updatedAt = m.now;
  log_(m, 'ACK_NOTE', c.id, actor, note || '(cleared)');
  return true;
}

/** Manager closes an OPEN cycle without proof (leave / holiday). Counts as acknowledgement. */
function waiveCycle_(m, c, actor, note) {
  if (!c || c._bad || c.status !== STATUS.OPEN) return { ok: false, msg: 'Only open tasks can be waived.' };
  note = normalizeSpace_(note);
  closeCycle_(m, c, STATUS.WAIVED, 'Waived by ' + actor + (note ? ': ' + note : ''), actor);
  if (!c.ackAt) { c.ackAt = m.now; c.ackBy = actor; }
  const t = m.taskById[c.taskId];
  let next = null;
  if (t && t.valid && t.active && t.freq.kind === 'INTERVAL') next = scheduleNextInterval_(m, t, c);
  return { ok: true, next: next, msg: 'Waived.' + (next ? ' Next cycle due ' + fmtShort_(next.dueAt) + '.' : '') };
}


// ===== 06_Notify.js =====
/**
 * 06_Notify — reminders, same-day manager alerts, leadership escalation, resolved notices.
 * Spec: specs/features/F07-notifications-sla-escalation.md, F08-idempotency-no-duplicates.md
 *
 * One email per recipient per event type per run; each cycle is stamped once per event type.
 * Stamps are written and saved straight after a successful send, so a failure later in the
 * run can never cause a resend, and a failed send is retried on the next run.
 */

function escalationReasons_(c, m) {
  const reasons = [];
  const t = m.now.getTime();
  const ackDl = ackDeadline_(c.alertAt, m.cfg);
  if (!c.ackAt && t >= ackDl.getTime()) reasons.push('Manager did not acknowledge by ' + fmtShort_(ackDl));
  const resDl = resolveDeadline_(c.dueAt, m.cfg);
  if (t >= resDl.getTime()) reasons.push('Task still not completed by ' + fmtShort_(resDl));
  return reasons;
}

function processNotifications_(ctx, m) {
  const cfg = m.cfg;
  const now = m.now;
  const t = now.getTime();
  const reminders = {};
  const alerts = {};
  const escalations = [];
  const resolved = [];
  const push = function (map, key, item) { (map[key] = map[key] || []).push(item); };
  const noEmail = {};
  m.emailsSent = m.emailsSent || 0;

  liveCycles_(m).forEach(function (c) {
    if (c.status === STATUS.OPEN) {
      if (cfg.reminderLeadMin > 0 && !c.reminderAt && t < c.dueAt.getTime() &&
          t >= reminderAt_(c.dueAt, cfg).getTime() && t >= c.opensAt.getTime()) {
        const emp = m.teamByName[c.employee];
        if (emp && emp.email) push(reminders, emp.email, c);
        else noEmail[c.employee] = true;
      }
      if (!c.alertAt && t >= managerAlertAt_(c.dueAt, cfg).getTime()) {
        if (c.ackAt) {
          c.alertAt = now;
          c.updatedAt = now;
          log_(m, 'ALERT_SKIPPED', c.id, 'system', 'Manager had already acknowledged — no alert email needed');
        } else {
          const mgr = managerFor_(m, c.employee);
          if (mgr) push(alerts, mgr, c);
          else m.warnings.push('No manager email for ' + c.employee + ' — alert for ' + c.id + ' cannot be sent');
        }
      }
      if (c.alertAt && !c.escalatedAt) {
        const reasons = escalationReasons_(c, m);
        if (reasons.length) escalations.push({ c: c, reasons: reasons });
      }
    } else if (c.escalatedAt && !c.resolvedNoticeAt && c.status !== STATUS.SKIPPED) {
      resolved.push(c);
    }
  });
  Object.keys(noEmail).forEach(function (n) { m.warnings.push('Team: ' + n + ' has no email — reminders are skipped'); });

  Object.keys(reminders).forEach(function (to) {
    const items = reminders[to].sort(byDue_);
    deliver_(ctx, m, 'REMINDER', buildReminderEmail_(ctx, m, to, items), items,
      function (c) { c.reminderAt = now; }, 'REMINDER_SENT');
  });

  Object.keys(alerts).forEach(function (to) {
    const items = alerts[to].sort(byDue_);
    deliver_(ctx, m, 'MANAGER_ALERT', buildManagerAlertEmail_(ctx, m, to, items), items,
      function (c) { c.alertAt = now; }, 'MANAGER_ALERT_SENT');
  });

  if (escalations.length) {
    if (!cfg.leadershipEmails.length) {
      m.warnings.push(escalations.length + ' item(s) are due for leadership escalation but LEADERSHIP_EMAILS is empty');
    } else {
      const items = escalations.map(function (e) { return e.c; }).sort(byDue_);
      const reasonById = {};
      escalations.forEach(function (e) { reasonById[e.c.id] = e.reasons.join('; '); });
      deliver_(ctx, m, 'LEADERSHIP_ESCALATION', buildEscalationEmail_(ctx, m, items, reasonById), items,
        function (c) { c.escalatedAt = now; c.escalationReason = reasonById[c.id]; }, 'ESCALATED');
    }
  }

  if (resolved.length && cfg.leadershipEmails.length) {
    const items = resolved.sort(byDue_);
    deliver_(ctx, m, 'RESOLVED_NOTICE', buildResolvedEmail_(ctx, m, items), items,
      function (c) { c.resolvedNoticeAt = now; }, 'RESOLVED_NOTICE_SENT');
  }
}

function deliver_(ctx, m, type, msg, cycles, mark, event) {
  const ids = cycles.map(function (c) { return c.id; });
  msg.type = type;
  msg.cycleIds = ids;
  let res;
  try {
    res = ctx.mailer.send(msg) || {};
  } catch (err) {
    const why = String((err && err.message) || err);
    appendEmailLog_(ctx, [m.now, type, msg.to, msg.cc || '', msg.subject, ids.join(', '), 'FAILED', why]);
    cycles.forEach(function (c) { log_(m, 'EMAIL_FAILED', c.id, 'system', type + ': ' + why); });
    m.warnings.push(type + ' email to ' + msg.to + ' failed (' + why + ') — it will be retried on the next run');
    return false;
  }
  cycles.forEach(function (c) {
    mark(c);
    c.updatedAt = m.now;
    log_(m, event, c.id, 'system', 'To ' + msg.to + (msg.cc ? ' · cc ' + msg.cc : ''));
  });
  saveCycles_(ctx, m);
  appendEmailLog_(ctx, [m.now, type, msg.to, msg.cc || '', msg.subject, ids.join(', '), res.delivery || 'SENT', '']);
  m.emailsSent++;
  return true;
}

/* ───────────────────────── email builders ───────────────────────── */

function sheetLink_(ctx, name) {
  const url = ctx.ss.getUrl();
  const sh = name ? ctx.ss.getSheetByName(name) : null;
  return sh ? url + '#gid=' + sh.getSheetId() : url;
}

function managersCc_(m, items) {
  return uniq_(items.map(function (c) { return managerFor_(m, c.employee); }).filter(function (e) {
    return e && m.cfg.leadershipEmails.indexOf(e) < 0;
  })).join(', ');
}

function employeesOf_(items) {
  return uniq_(items.map(function (c) { return c.employee; })).join(', ');
}

/** o: {accent, heading, intro, headers[], rows[][] (already-escaped HTML), outro, cta:{label,url}} */
function emailHtml_(o) {
  const th = o.headers.map(function (h) {
    return '<th style="text-align:left;padding:8px 10px;font-size:12px;font-weight:600;color:#4b5563;' +
      'background:#f3f4f6;border-bottom:1px solid #e5e7eb">' + escapeHtml_(h) + '</th>';
  }).join('');
  const trs = o.rows.map(function (r) {
    return '<tr>' + r.map(function (cell) {
      return '<td style="padding:8px 10px;font-size:13px;color:#1f2933;border-bottom:1px solid #eef0f3;vertical-align:top">' + cell + '</td>';
    }).join('') + '</tr>';
  }).join('');
  // Table-cell ("bulletproof") button: Outlook ignores padding on <a>, so the padded cell carries the shape.
  const cta = o.cta && o.cta.url
    ? '<table role="presentation" cellspacing="0" cellpadding="0" style="margin:20px 0 0"><tr><td bgcolor="#1f2933" ' +
      'style="background:#1f2933;border-radius:6px;padding:12px 20px"><a href="' + escapeHtml_(o.cta.url) +
      '" style="color:#ffffff;text-decoration:none;font-size:15px;font-weight:bold;display:inline-block">' +
      escapeHtml_(o.cta.label) + '</a></td></tr></table>'
    : '';
  return '<div style="font-family:Arial,Helvetica,sans-serif;color:#1f2933;max-width:680px;margin:0 auto;padding:8px">' +
    '<div style="padding-top:8px">' +
    '<h2 style="font-size:21px;line-height:1.3;margin:0 0 12px;color:' + o.accent + '">' + escapeHtml_(o.heading) + '</h2>' +
    '<p style="font-size:15px;line-height:1.5;margin:0 0 14px">' + o.intro + '</p>' +
    '<table role="presentation" cellspacing="0" cellpadding="0" style="border-collapse:collapse;width:100%;border:1px solid #e5e7eb">' +
    '<thead><tr>' + th + '</tr></thead><tbody>' + trs + '</tbody></table>' +
    cta + (o.outro || '') +
    '<p style="font-size:12px;color:#6b7280;margin-top:24px">' + escapeHtml_(APP_NAME) +
    ' · automated message · each event is emailed once, never repeated.</p>' +
    '</div></div>';
}

function textTable_(headers, rows) {
  return rows.map(function (r) {
    return '- ' + r.map(function (v, i) { return headers[i] + ': ' + v; }).join(' | ');
  }).join('\n');
}

function proofHint_(c, cfg) {
  return c.proofType === PROOF.DAILY
    ? 'Paste the update you posted on WhatsApp (min ' + cfg.dailyMinChars + ' characters)'
    : 'Portal Ticket ID (e.g. PRT-10234)';
}

function buildReminderEmail_(ctx, m, to, items) {
  const emp = items[0].employee;
  const headers = ['Task', 'Cut-off', 'What to enter'];
  const plain = items.map(function (c) { return [c.taskName, fmtShort_(c.dueAt), proofHint_(c, m.cfg)]; });
  const link = sheetLink_(ctx, employeeTabName_(emp));
  const first = items[0].dueAt;
  return {
    to: to,
    cc: '',
    subject: 'Reminder: ' + (items.length === 1 ? items[0].taskName : items.length + ' tasks') + ' due at ' + fmt_(first, 'HH:mm') + ' today',
    htmlBody: emailHtml_({
      accent: '#b45309',
      heading: 'Hi ' + emp + ', ' + (items.length === 1 ? 'one task is' : items.length + ' tasks are') + ' due at ' + fmt_(first, 'HH:mm') + ' today',
      intro: 'Finish the task, then enter the Ticket ID or your update in the “✍️ Enter Ticket ID / update here” column on your tab and press Enter. That single entry closes it. There is nothing else to update.',
      headers: headers,
      rows: plain.map(function (r) { return r.map(escapeHtml_); }),
      outro: '',
      cta: { label: 'Open my tasks', url: link },
    }),
    body: 'Hi ' + emp + ',\n\nDue today:\n' + textTable_(headers, plain) + '\n\nOpen your tab: ' + link,
  };
}

function buildManagerAlertEmail_(ctx, m, to, items) {
  const ackDl = ackDeadline_(m.now, m.cfg);
  const n = items.length;
  const single = n === 1;
  const dash = sheetLink_(ctx, SHEETS.DASHBOARD);
  const firstUrl = ackUrl_(ctx, m, items[0].id);
  // One task: the acknowledgement is the big button. Several: a per-row link in the FIRST column (thumb-reachable).
  const headers = single ? ['Employee', 'Task', 'Overdue by', 'Must be done by'] : ['Acknowledge', 'Employee', 'Task', 'Overdue by', 'Must be done by'];
  const rowsPlain = [];
  const rowsHtml = items.map(function (c) {
    const url = ackUrl_(ctx, m, c.id);
    const cells = [c.employee, c.taskName, durationText_(m.now - c.dueAt) + ' (cut-off ' + fmt_(c.dueAt, 'HH:mm') + ')',
      fmtShort_(resolveDeadline_(c.dueAt, m.cfg))];
    rowsPlain.push(cells.concat([url || 'tick ✅ Ack on the Manager Dashboard']));
    const htmlCells = cells.map(escapeHtml_);
    if (single) return htmlCells;
    return [url ? '<a href="' + escapeHtml_(url) + '" style="color:#1d4ed8;font-weight:bold">Acknowledge</a>' : 'On dashboard'].concat(htmlCells);
  });
  const ackHow = firstUrl
    ? (single ? 'press <b>Acknowledge now</b> above' : 'use the Acknowledge link on each row') + ', or tick ✅ Ack on the Manager Dashboard'
    : 'tick ✅ Ack on the Manager Dashboard';
  const outro =
    '<p style="font-size:15px;margin:20px 0 6px"><b>What we need from you</b></p>' +
    '<ol style="font-size:15px;line-height:1.6;margin:0;padding-left:20px">' +
    '<li>Check with the employee why it is still pending.</li>' +
    '<li><b>Acknowledge by ' + escapeHtml_(fmtShort_(ackDl)) + '</b>: ' + ackHow + ' (a short note helps).</li>' +
    '<li>Make sure it is completed by the “Must be done by” time. If the person is on leave, choose <i>Waive</i> on the dashboard.</li>' +
    '</ol><p style="font-size:15px;line-height:1.5">If either deadline is missed, leadership is informed automatically. ' +
    '<a href="' + escapeHtml_(dash) + '" style="color:#1d4ed8">Open the Manager Dashboard</a></p>';
  return {
    to: to,
    cc: '',
    subject: '[Action needed] ' + n + ' recurring task' + (n > 1 ? 's' : '') + ' pending today — ' + employeesOf_(items),
    htmlBody: emailHtml_({
      accent: '#dc2626',
      heading: single ? items[0].employee + ' has not completed “' + items[0].taskName + '”' : n + ' recurring tasks were not completed by their cut-off',
      intro: 'Still open at ' + escapeHtml_(fmtShort_(m.now)) + ', after the cut-off and a ' + m.cfg.graceMin + '-minute grace period.',
      headers: headers,
      rows: rowsHtml,
      outro: outro,
      cta: single && firstUrl ? { label: 'Acknowledge now', url: firstUrl } : null,
    }),
    body: 'Pending after cut-off:\n' + textTable_(['Employee', 'Task', 'Overdue by', 'Must be done by', 'Acknowledge'], rowsPlain) +
      '\n\nPlease (1) check with the employee, (2) acknowledge by ' + fmtShort_(ackDl) +
      ', (3) make sure each task is completed by its "Must be done by" time (or waive it on the dashboard).\nDashboard: ' + dash,
  };
}

function buildEscalationEmail_(ctx, m, items, reasonById) {
  const headers = ['Why escalated', 'Employee', 'Task', 'Overdue by', 'Manager acknowledged?'];
  const plain = items.map(function (c) {
    return [reasonById[c.id], c.employee, c.taskName, durationText_(m.now - c.dueAt),
      c.ackAt ? 'Yes, ' + fmtShort_(c.ackAt) + (c.ackNote ? ' — "' + c.ackNote + '"' : '') : 'No (alerted ' + fmtShort_(c.alertAt) + ')'];
  });
  const dash = sheetLink_(ctx, SHEETS.DASHBOARD);
  const n = items.length;
  return {
    to: m.cfg.leadershipEmails.join(', '),
    cc: managersCc_(m, items),
    subject: '[Escalation] ' + n + ' recurring task' + (n > 1 ? 's' : '') + ' unresolved — ' + employeesOf_(items),
    htmlBody: emailHtml_({
      accent: '#7f1d1d',
      heading: 'Escalation: ' + (n === 1 ? 'a recurring task is' : n + ' recurring tasks are') + ' still unresolved',
      intro: 'These items missed the agreed deadlines after the manager was alerted. No action is needed from you unless you want to follow up: reply to the manager, who is copied.',
      headers: headers,
      rows: plain.map(function (r) { return r.map(escapeHtml_); }),
      outro: '<p style="font-size:15px;line-height:1.5;margin-top:16px">You will get one more message when each item is resolved. No repeat reminders will be sent.</p>',
      cta: { label: 'Open Manager Dashboard', url: dash },
    }),
    body: 'Escalated:\n' + textTable_(headers, plain) + '\n\nDashboard: ' + dash,
  };
}

function buildResolvedEmail_(ctx, m, items) {
  const headers = ['Employee', 'Task', 'Cut-off', 'Outcome', 'Closed at'];
  const plain = items.map(function (c) {
    const outcome = c.status === STATUS.WAIVED ? c.closeNote : statusLabel_(c.status) + (c.proof ? ' · ' + truncate_(c.proof, 60) : '');
    return [c.employee, c.taskName, fmtShort_(c.dueAt), outcome, fmtShort_(c.completedAt || c.updatedAt)];
  });
  const n = items.length;
  return {
    to: m.cfg.leadershipEmails.join(', '),
    cc: managersCc_(m, items),
    subject: '[Resolved] ' + n + ' escalated task' + (n > 1 ? 's' : '') + ' closed — ' + employeesOf_(items),
    htmlBody: emailHtml_({
      accent: '#15803d',
      heading: n === 1 ? 'Resolved: ' + items[0].taskName + ' (' + items[0].employee + ')' : n + ' escalated tasks are now closed',
      intro: 'Closing the loop on the earlier escalation.',
      headers: headers,
      rows: plain.map(function (r) { return r.map(escapeHtml_); }),
      outro: '',
      cta: { label: 'Open Manager Dashboard', url: sheetLink_(ctx, SHEETS.DASHBOARD) },
    }),
    body: 'Resolved:\n' + textTable_(headers, plain),
  };
}


// ===== 07_Views.js =====
/**
 * 07_Views — generated, disposable views: one tab per employee and the Manager Dashboard.
 * Spec: F02 (employee view), F06 (dashboard). Rendered with one batched write per property.
 */

function employeeTabName_(name) {
  return EMPLOYEE_TAB_PREFIX + sanitizeSheetName_(name);
}

/* ───────────── grid builder: values + formats + colours, flushed in a handful of calls ───────────── */

function newGrid_(width) {
  return { width: width, values: [], formats: [], bgs: [], weights: [], colors: [], checks: [], lists: [], wraps: [] };
}

/**
 * opts: {bold, bg, color, cellBg: {colIndex0: '#hex'}, cellColor: {...}}. Returns the 1-based row number.
 * Only explicit {formula: '=...'} cells become formulas. Every string is written as plain text ('@'),
 * so user-supplied text such as '=IMPORTDATA(...)' is never evaluated (formula-injection safe).
 */
function addRow_(g, cells, opts) {
  opts = opts || {};
  const vals = [];
  const fm = [];
  const bg = [];
  const wt = [];
  const fc = [];
  for (let i = 0; i < g.width; i++) {
    let v = cells ? cells[i] : '';
    if (v === undefined || v === null) v = '';
    let f = FMT.TEXT;
    if (v && typeof v === 'object' && !isDate_(v) && v.formula) { v = v.formula; f = FMT.PLAIN; }
    else if (isDate_(v)) f = FMT.VIEW_DT;
    else if (typeof v === 'boolean' || typeof v === 'number') f = FMT.PLAIN;
    vals.push(v);
    fm.push(f);
    bg.push((opts.cellBg && opts.cellBg[i]) || opts.bg || COLORS.WHITE);
    wt.push(opts.bold ? 'bold' : 'normal');
    fc.push((opts.cellColor && opts.cellColor[i]) || opts.color || COLORS.INK);
  }
  g.values.push(vals);
  g.formats.push(fm);
  g.bgs.push(bg);
  g.weights.push(wt);
  g.colors.push(fc);
  return g.values.length;
}

function flushGrid_(sh, g) {
  const n = g.values.length;
  const W = g.width;
  sh.clear();
  sh.getRange(1, 1, sh.getMaxRows(), sh.getMaxColumns()).clearDataValidations();
  ensureRows_(sh, n + 2);
  ensureCols_(sh, W);
  const rng = sh.getRange(1, 1, n, W);
  rng.setNumberFormats(g.formats);
  // insertCheckboxes resets cells to FALSE, so it must run before the values are written.
  g.checks.forEach(function (c) { if (c[2] > 0) sh.getRange(c[0], c[1], c[2], 1).insertCheckboxes(); });
  g.lists.forEach(function (l) {
    if (l[2] > 0) {
      sh.getRange(l[0], l[1], l[2], 1).setDataValidation(
        SpreadsheetApp.newDataValidation().requireValueInList(l[3], true).setAllowInvalid(false).build());
    }
  });
  rng.setValues(g.values);
  rng.setBackgrounds(g.bgs);
  rng.setFontWeights(g.weights);
  rng.setFontColors(g.colors);
  rng.setVerticalAlignment('top');
  g.wraps.forEach(function (w) { if (w[2] > 0) sh.getRange(w[0], w[1], w[2], w[3]).setWrap(true); });
  sh.getRange(1, TITLE_COL).setFontSize(15);
}

// Literals (not COLORS.*) because top-level code must not depend on load order of other files.
const SECTION_STYLE = { bold: true, bg: '#e8edf5' };
const HEADER_STYLE = { bold: true, bg: '#f3f4f6' };
const MUTED_STYLE = { color: '#6b7280' };

/* ───────────── shared labels ───────────── */

function openStatus_(c, m) {
  const now = m.now;
  if (now.getTime() < c.opensAt.getTime()) return { label: 'Opens ' + fmtShort_(c.opensAt), bg: COLORS.QUIET_BG };
  if (now.getTime() > c.dueAt.getTime()) {
    const by = durationText_(now - c.dueAt);
    if (c.escalatedAt) return { label: '🔴 Overdue ' + by + ' — escalated to leadership', bg: COLORS.ESC_BG };
    if (c.alertAt) return { label: '🟠 Overdue ' + by + ' — manager alerted', bg: COLORS.BAD_BG };
    return { label: '⚠️ Overdue by ' + by, bg: COLORS.BAD_BG };
  }
  if (sameDay_(now, c.dueAt)) return { label: '⏰ Due today ' + fmt_(c.dueAt, 'HH:mm'), bg: COLORS.WARN_BG };
  const days = Math.round((startOfDay_(c.dueAt) - startOfDay_(now)) / 86400000);
  return { label: days === 1 ? 'Due tomorrow' : 'Due in ' + days + ' days', bg: COLORS.OK_BG };
}

function closedAt_(c) {
  return c.completedAt || c.updatedAt;
}

function waShareFormula_(text) {
  const url = 'https://wa.me/?text=' + encodeURIComponent(text);
  if (url.length > 1800) return 'Text too long for a share link';
  return { formula: '=HYPERLINK("' + url + '","📤 Share on WhatsApp")' };
}

/* ───────────── employee tabs ───────────── */
// Visible columns: B Task · C Status · D Proof required · E ✍️ input · F Result · G What to do · H Cut-off · I Frequency
// (A = hidden Cycle ID). Input and feedback sit next to the task so they fit on a phone screen.

function styleEmployeeTab_(sh) {
  [40, 200, 210, 220, 300, 300, 280, 140, 110].forEach(function (w, i) { sh.setColumnWidth(i + 1, w); });
  sh.hideColumns(ID_COL);
  sh.setHiddenGridlines(true);
  sh.setTabColor('#f59e0b');
  try {
    const p = sh.protect().setDescription('Generated view — only the "✍️ Enter Ticket ID / update here" column is for input').setWarningOnly(true);
    p.setUnprotectedRanges([sh.getRange(EMP_VIEW.FIRST_ROW, EMP_VIEW.INPUT_COL, sh.getMaxRows() - EMP_VIEW.FIRST_ROW + 1, 1)]);
  } catch (e) {
    // Protection is a convenience; never block rendering on it.
  }
}

/** only: optional list of employee names to re-render (edits touch one tab, not all of them). */
function renderEmployeeTabs_(ctx, m, only) {
  const ss = ctx.ss;
  const wanted = {};
  m.team.filter(function (e) { return e.active; }).forEach(function (e) {
    const name = employeeTabName_(e.name);
    wanted[name] = true;
    if (only && only.indexOf(e.name) < 0 && ss.getSheetByName(name)) return;
    let sh = ss.getSheetByName(name);
    if (!sh) {
      const dash = ss.getSheetByName(SHEETS.DASHBOARD);
      const idx = dash ? ss.getSheets().indexOf(dash) + 1 : ss.getSheets().length;
      sh = ss.insertSheet(name, idx);
      styleEmployeeTab_(sh);
    }
    renderEmployeeTab_(ctx, m, e, sh);
  });
  ss.getSheets().forEach(function (sh) {
    const n = sh.getName();
    if (n.indexOf(EMPLOYEE_TAB_PREFIX) === 0 && !wanted[n]) ss.deleteSheet(sh);
  });
}

function renderEmployeeTab_(ctx, m, e, sh) {
  const now = m.now;
  const cfg = m.cfg;
  const mine = liveCycles_(m).filter(function (c) { return c.employee === e.name; });
  const open = mine.filter(function (c) { return c.status === STATUS.OPEN; }).sort(byDue_);
  const actionable = open.filter(function (c) { return now.getTime() >= c.opensAt.getTime(); });
  const upcoming = open.filter(function (c) { return now.getTime() < c.opensAt.getTime(); });
  const since = addDays_(startOfDay_(now), -cfg.recentDays);
  const done = mine.filter(function (c) {
    return c.status !== STATUS.OPEN && closedAt_(c) && closedAt_(c).getTime() >= since.getTime();
  }).sort(function (a, b) { return closedAt_(b) - closedAt_(a); });
  const overdue = actionable.filter(function (c) { return now.getTime() > c.dueAt.getTime(); }).length;

  const g = newGrid_(EMP_VIEW.WIDTH);
  addRow_(g, ['', e.name + ' — my recurring tasks'], { bold: true });
  addRow_(g, ['', 'When a task is done, type the Ticket ID (portal tasks) or paste the update you shared on WhatsApp (daily task) ' +
    'in the “✍️ Enter Ticket ID / update here” column and press Enter. That one entry records who and when, closes the task ' +
    'and schedules the next one. There is nothing else to update.'], MUTED_STYLE);
  addRow_(g, ['', 'As of ' + fmtLong_(now) + '  ·  ' + actionable.length + ' need action  ·  ' + overdue + ' overdue'],
    { color: overdue ? '#b42318' : COLORS.MUTED, bold: overdue > 0 });
  addRow_(g, []);
  addRow_(g, ['', 'ACTION NEEDED'], SECTION_STYLE);
  addRow_(g, ['Cycle ID', 'Task', 'Status', 'Proof required', '✍️ Enter Ticket ID / update here', 'Result',
    'What to do', 'Cut-off', 'Frequency'], HEADER_STYLE);
  const firstAction = g.values.length + 1;
  if (!actionable.length) addRow_(g, ['', '🎉 Nothing needs your action right now.'], MUTED_STYLE);
  actionable.forEach(function (c) {
    const st = openStatus_(c, m);
    const t = m.taskById[c.taskId];
    addRow_(g, [c.id, c.taskName, st.label, proofHint_(c, cfg), '', '', t ? t.instructions : '', c.dueAt, c.frequency],
      { cellBg: { 2: st.bg, 4: COLORS.INPUT_BG } });
  });
  g.wraps.push([firstAction, 2, g.values.length - firstAction + 1, 6]);

  addRow_(g, []);
  addRow_(g, ['', 'COMING UP — not open for entry yet'], SECTION_STYLE);
  addRow_(g, ['Cycle ID', 'Task', 'Opens for entry', 'Cut-off', '', '', '', '', 'Frequency'], HEADER_STYLE);
  if (!upcoming.length) addRow_(g, ['', 'Nothing scheduled yet.'], MUTED_STYLE);
  upcoming.forEach(function (c) {
    addRow_(g, [c.id, c.taskName, c.opensAt, c.dueAt, '', '', '', '', c.frequency], { color: COLORS.MUTED });
  });

  addRow_(g, []);
  addRow_(g, ['', 'COMPLETED — last ' + cfg.recentDays + ' days'], SECTION_STYLE);
  addRow_(g, ['Cycle ID', 'Task', 'Result', 'Closed at', 'Share', 'Proof / update', '', 'Cut-off', ''], HEADER_STYLE);
  const firstDone = g.values.length + 1;
  if (!done.length) addRow_(g, ['', 'Nothing completed in this period yet.'], MUTED_STYLE);
  done.forEach(function (c) {
    const share = c.proofType === PROOF.DAILY && c.proof && (c.status === STATUS.DONE || c.status === STATUS.LATE)
      ? waShareFormula_(c.proof) : '';
    const bg = c.status === STATUS.DONE ? COLORS.OK_BG : (c.status === STATUS.LATE ? COLORS.WARN_BG : COLORS.QUIET_BG);
    addRow_(g, [c.id, c.taskName, (c.status === STATUS.DONE || c.status === STATUS.LATE ? '✅ ' : '') + statusLabel_(c.status),
      closedAt_(c), share, c.proof || c.closeNote, '', c.dueAt, ''], { cellBg: { 2: bg } });
  });
  g.wraps.push([firstDone, 6, g.values.length - firstDone + 1, 1]);
  flushGrid_(sh, g);
}

/* ───────────── manager dashboard ───────────── */
// Needs-attention columns: B Employee · C Task · D Overdue by · E Task status · F Manager note · G ✅ Ack · H Action ·
// I Escalation · J Cut-off · K Manager alerted · L Acknowledged at (A = hidden Cycle ID). Note sits before the tick
// so "type a note, then tick" reads left to right.

function styleDashboard_(sh) {
  [40, 130, 190, 110, 170, 240, 60, 170, 300, 140, 140, 140].forEach(function (w, i) { sh.setColumnWidth(i + 1, w); });
  sh.hideColumns(ID_COL);
  sh.setHiddenGridlines(true);
  sh.setTabColor('#1f2933');
}

function lastRunKey_(ss) {
  return 'LAST_RUN_' + ss.getId();
}

function renderDashboard_(ctx, m) {
  const ss = ctx.ss;
  let sh = ss.getSheetByName(SHEETS.DASHBOARD);
  if (!sh) {
    sh = ss.insertSheet(SHEETS.DASHBOARD, 0);
    styleDashboard_(sh);
  }
  const now = m.now;
  const cfg = m.cfg;
  const live = liveCycles_(m);
  const since = addDays_(startOfDay_(now), -cfg.recentDays);
  const lastRun = PropertiesService.getScriptProperties().getProperty(lastRunKey_(ss));
  const g = newGrid_(DASH.WIDTH);

  addRow_(g, ['', 'Manager Dashboard — recurring tasks'], { bold: true });
  addRow_(g, ['', 'For an overdue task: type a note (optional), tick ✅ Ack, and make sure it gets done. ' +
    'Choose Action → Waive only if the person is on leave or it is a holiday. Everything else updates automatically.'], MUTED_STYLE);
  addRow_(g, ['', 'As of ' + fmtLong_(now) + (lastRun ? '  ·  engine last ran ' + lastRun : '') + '  ·  email mode: ' + cfg.emailMode +
    (cfg.simulatedNow ? '  ·  ⏱ DEMO CLOCK ACTIVE (Config → SIMULATED_NOW)' : '')], MUTED_STYLE);
  const warnings = uniq_(m.warnings);
  if (warnings.length) addRow_(g, ['', '⚠️ ' + warnings.slice(0, 6).join('   |   ') + (warnings.length > 6 ? '   (+' + (warnings.length - 6) + ' more)' : '')], { bg: COLORS.WARN_BG });
  else addRow_(g, []);
  addRow_(g, []);

  // Team overview
  addRow_(g, ['', DASH.TITLE_OVERVIEW], SECTION_STYLE);
  addRow_(g, ['', 'Employee', 'Need action', 'Due today', 'Overdue', 'Awaiting your ack', 'Escalated', 'Done (7 days)', 'On-time % (30 days)'], HEADER_STYLE);
  const activeTeam = m.team.filter(function (e) { return e.active; });
  if (!activeTeam.length) addRow_(g, ['', 'No active employees on the Team sheet.'], MUTED_STYLE);
  activeTeam.forEach(function (e) {
    const mine = live.filter(function (c) { return c.employee === e.name; });
    const open = mine.filter(function (c) { return c.status === STATUS.OPEN; });
    const need = open.filter(function (c) { return now.getTime() >= c.opensAt.getTime(); }).length;
    const dueToday = open.filter(function (c) { return now.getTime() <= c.dueAt.getTime() && sameDay_(now, c.dueAt); }).length;
    const overdue = open.filter(function (c) { return now.getTime() > c.dueAt.getTime(); }).length;
    const awaiting = open.filter(function (c) { return c.alertAt && !c.ackAt; }).length;
    const escalated = open.filter(function (c) { return c.escalatedAt; }).length;
    const week = addDays_(now, -7).getTime();
    const done7 = mine.filter(function (c) { return (c.status === STATUS.DONE || c.status === STATUS.LATE) && c.completedAt && c.completedAt.getTime() >= week; }).length;
    const month = addDays_(now, -30).getTime();
    const due30 = mine.filter(function (c) {
      return c.dueAt.getTime() <= now.getTime() && c.dueAt.getTime() >= month && c.status !== STATUS.WAIVED;
    });
    const onTime = due30.filter(function (c) { return c.status === STATUS.DONE; }).length;
    const pct = due30.length ? Math.round(onTime * 100 / due30.length) + '%' : '—';
    addRow_(g, ['', e.name, need, dueToday, overdue, awaiting, escalated, done7, pct], {
      cellBg: {
        3: dueToday ? COLORS.WARN_BG : null,
        4: overdue ? COLORS.BAD_BG : COLORS.OK_BG,
        5: awaiting ? COLORS.BAD_BG : null,
        6: escalated ? COLORS.ESC_BG : null,
      },
    });
  });
  addRow_(g, []);

  // Needs attention
  addRow_(g, ['', DASH.TITLE_ATTENTION], SECTION_STYLE);
  addRow_(g, ['Cycle ID', 'Employee', 'Task', 'Overdue by', 'Task status', 'Manager note', '✅ Ack', 'Action',
    'Escalation', 'Cut-off', 'Manager alerted', 'Acknowledged at'], HEADER_STYLE);
  const attn = live.filter(function (c) {
    if (c.status === STATUS.OPEN) return now.getTime() > c.dueAt.getTime();
    return !!c.alertAt && c.status !== STATUS.SKIPPED && closedAt_(c).getTime() >= since.getTime();
  }).sort(function (a, b) {
    const ao = a.status === STATUS.OPEN ? 0 : 1;
    const bo = b.status === STATUS.OPEN ? 0 : 1;
    return ao - bo || a.dueAt - b.dueAt;
  });
  const firstAttn = g.values.length + 1;
  if (!attn.length) addRow_(g, ['', '✅ Nothing overdue. No alerts in the last ' + cfg.recentDays + ' days.'], MUTED_STYLE);
  let openCount = 0;
  attn.forEach(function (c) {
    const isOpen = c.status === STATUS.OPEN;
    if (isOpen) openCount++;
    let status;
    if (isOpen) status = c.escalatedAt ? '🔴 Open — escalated' : '🟠 Open';
    else if (c.status === STATUS.WAIVED) status = '⚪ Waived';
    else status = '✅ ' + statusLabel_(c.status) + (c.alertAt && c.completedAt && c.completedAt.getTime() >= c.alertAt.getTime() ? ' (after alert)' : '');
    const overdueBy = isOpen ? durationText_(now - c.dueAt) : 'closed ' + fmtShort_(closedAt_(c));
    const alerted = c.alertAt || (isOpen ? 'due ' + fmtShort_(managerAlertAt_(c.dueAt, cfg)) : '—');
    let esc;
    if (c.escalatedAt) esc = '🔴 ' + fmtShort_(c.escalatedAt) + ' — ' + c.escalationReason;
    else if (!isOpen) esc = '—';
    else if (c.alertAt) {
      esc = (c.ackAt ? '' : 'Leadership at ' + fmtShort_(ackDeadline_(c.alertAt, cfg)) + ' if not acknowledged · ') +
        'at ' + fmtShort_(resolveDeadline_(c.dueAt, cfg)) + ' if not done';
    } else esc = 'Manager alert due ' + fmtShort_(managerAlertAt_(c.dueAt, cfg));
    const statusBg = isOpen ? (c.escalatedAt ? COLORS.ESC_BG : COLORS.BAD_BG) : COLORS.OK_BG;
    // Closed rows are a record, not a to-do: no checkbox, no yellow input affordance.
    const ackCell = isOpen ? !!c.ackAt : (c.ackAt ? '✅' : '—');
    addRow_(g, [c.id, c.employee, c.taskName, overdueBy, status, c.ackNote, ackCell, '', esc, c.dueAt, alerted, c.ackAt || ''], {
      cellBg: {
        4: statusBg,
        5: isOpen ? COLORS.INPUT_BG : COLORS.QUIET_BG,
        6: isOpen ? COLORS.INPUT_BG : COLORS.QUIET_BG,
        7: isOpen ? COLORS.INPUT_BG : null,
      },
    });
  });
  if (attn.length) {
    g.checks.push([firstAttn, DASH.ACK_COL, openCount]);
    g.lists.push([firstAttn, DASH.ACTION_COL, openCount, [ACTION_WAIVE]]);
    g.wraps.push([firstAttn, 3, attn.length, 1], [firstAttn, DASH.NOTE_COL, attn.length, 1], [firstAttn, 9, attn.length, 1]);
  }
  addRow_(g, []);

  // All open
  const allOpen = live.filter(function (c) { return c.status === STATUS.OPEN; }).sort(byDue_);
  addRow_(g, ['', DASH.TITLE_OPEN + ' (' + allOpen.length + ')'], SECTION_STYLE);
  addRow_(g, ['Cycle ID', 'Employee', 'Task', 'Status', 'Cut-off', 'Frequency'], HEADER_STYLE);
  if (!allOpen.length) addRow_(g, ['', 'No open tasks.'], MUTED_STYLE);
  allOpen.forEach(function (c) {
    const st = openStatus_(c, m);
    addRow_(g, [c.id, c.employee, c.taskName, st.label, c.dueAt, c.frequency], { cellBg: { 3: st.bg } });
  });
  addRow_(g, []);

  // Recent completions
  addRow_(g, ['', DASH.TITLE_RECENT + ' — last ' + cfg.recentDays + ' days'], SECTION_STYLE);
  addRow_(g, ['Cycle ID', 'Employee', 'Task', 'Result', 'Completed at', 'Completed by', 'Proof / update', 'Cut-off'], HEADER_STYLE);
  const recent = live.filter(function (c) {
    return (c.status === STATUS.DONE || c.status === STATUS.LATE) && c.completedAt && c.completedAt.getTime() >= since.getTime();
  }).sort(function (a, b) { return b.completedAt - a.completedAt; });
  const firstRecent = g.values.length + 1;
  if (!recent.length) addRow_(g, ['', 'No completions in this period yet.'], MUTED_STYLE);
  recent.forEach(function (c) {
    addRow_(g, [c.id, c.employee, c.taskName, statusLabel_(c.status), c.completedAt, c.completedBy, c.proof, c.dueAt], {
      cellBg: { 3: c.status === STATUS.DONE ? COLORS.OK_BG : COLORS.WARN_BG },
    });
  });
  g.wraps.push([firstRecent, DASH.RECENT_PROOF_COL, g.values.length - firstRecent + 1, 1]);
  flushGrid_(sh, g);
}

/** only: optional employee names whose tabs changed; the dashboard is always refreshed. */
function renderAll_(ctx, m, only) {
  renderDashboard_(ctx, m);
  renderEmployeeTabs_(ctx, m, only);
}


// ===== 08_Edits.js =====
/**
 * 08_Edits — routes a spreadsheet edit to the right action.
 *   👤 employee tab, column H  → completion (F02/F03/F04)
 *   Manager Dashboard          → acknowledge / note / waive (F06)
 *   Tasks / Team / Config      → full engine run so changes apply immediately (F01 R5)
 * Returns a plain result object so tests can assert on it.
 */

/** Best-effort identity of the editor. Consumer accounts often hide other users' emails. */
function actorFromEvent_(e, onBehalfOf) {
  let email = '';
  try {
    if (e && e.user) email = typeof e.user === 'string' ? e.user : (e.user.getEmail ? e.user.getEmail() : '');
  } catch (x) { email = ''; }
  if (!email) {
    try { email = Session.getActiveUser().getEmail(); } catch (x) { email = ''; }
  }
  email = String(email || '').trim().toLowerCase();
  if (!onBehalfOf) return email || '';
  if (!email) return onBehalfOf.name + ' (via own tab)';
  if (onBehalfOf.email && email === onBehalfOf.email) return onBehalfOf.name + ' <' + email + '>';
  return email + ' (on behalf of ' + onBehalfOf.name + ')';
}

function toast_(ctx, msg, title) {
  try { ctx.ss.toast(truncate_(msg, 250), title || APP_NAME, 6); } catch (e) { /* toast is cosmetic */ }
}

function handleEditCore_(ctx, e) {
  if (!e || !e.range) return { handled: false, reason: 'no range' };
  const sh = e.range.getSheet();
  const name = sh.getName();
  if (name.indexOf(EMPLOYEE_TAB_PREFIX) === 0) return handleEmployeeEdit_(ctx, e, sh);
  if (name === SHEETS.DASHBOARD) return handleDashboardEdit_(ctx, e, sh);
  if (name === SHEETS.TASKS || name === SHEETS.TEAM || name === SHEETS.CONFIG) {
    if (name === SHEETS.TASKS && e.range.getColumn() === TASK_FIELDS.length && e.range.getNumColumns() === 1) {
      return { handled: false, reason: 'health column is system-written' };
    }
    const summary = runEngineCore_(ctx, { render: true });
    return { handled: true, kind: 'MASTER_DATA', summary: summary };
  }
  return { handled: false, reason: 'sheet not managed' };
}

function handleEmployeeEdit_(ctx, e, sh) {
  const r0 = e.range.getRow();
  const c0 = e.range.getColumn();
  const nr = e.range.getNumRows();
  const nc = e.range.getNumColumns();
  const IC = EMP_VIEW.INPUT_COL;
  if (c0 > IC || c0 + nc - 1 < IC) return { handled: false, reason: 'not the input column' };
  const first = Math.max(r0, EMP_VIEW.FIRST_ROW);
  const last = r0 + nr - 1;
  if (last < first) return { handled: false, reason: 'title/header rows' };

  const block = sh.getRange(first, 1, last - first + 1, EMP_VIEW.RESULT_COL).getValues();
  // The 15-minute refresh may have redrawn the tab while the user was typing: the cell then no longer
  // holds what they typed and the row may now be a different task. Never guess — ask them to re-enter.
  if (nr === 1 && nc === 1 && e.value !== undefined && e.value !== null &&
      String(block[0][IC - 1]) !== String(e.value)) {
    const msg = 'The sheet refreshed while you were typing, so nothing was saved. Please enter "' +
      truncate_(e.value, 40) + '" again on the right row.';
    toast_(ctx, msg);
    return { handled: true, kind: 'COMPLETION', outcomes: [{ row: r0, ok: false, code: 'REFRESHED', msg: msg }] };
  }

  const m = loadModel_(ctx);
  const tabName = sh.getName();
  const emp = m.team.find(function (t) { return employeeTabName_(t.name) === tabName; });
  if (!emp) return { handled: false, reason: 'tab does not match an employee' };
  const actor = actorFromEvent_(e, emp);

  const outcomes = [];
  block.forEach(function (row, i) {
    const input = row[IC - 1];
    if (input === '' || input === null || input === undefined) return;
    const id = String(row[0] || '').trim();
    const rowNum = first + i;
    let res;
    if (!id) res = { ok: false, code: 'NO_ROW', msg: 'Enter the ticket/update on a task row (one with a Cycle ID in column A).' };
    else if (!m.byId[id]) res = { ok: false, code: 'UNKNOWN', msg: 'This row is out of date — the sheet has been refreshed, please enter it again on the right row.' };
    else if (m.byId[id].employee !== emp.name) res = { ok: false, code: 'NOT_YOURS', msg: 'This task belongs to ' + m.byId[id].employee + '.' };
    else res = completeCycle_(m, m.byId[id], input, actor);
    outcomes.push(Object.assign({ row: rowNum, id: id, input: input }, res));
  });
  if (!outcomes.length) return { handled: false, reason: 'cell cleared' };

  const anyOk = outcomes.some(function (o) { return o.ok; });
  const stale = outcomes.some(function (o) { return o.code === 'NOT_OPEN' || o.code === 'UNKNOWN'; });
  const failures = outcomes.filter(function (o) { return !o.ok; });
  if (anyOk || stale) {
    saveModel_(ctx, m);
    renderAll_(ctx, m, [emp.name]);
    annotateEmployeeRows_(ctx.ss.getSheetByName(tabName), failures.filter(function (o) { return o.code !== 'NOT_OPEN' && o.code !== 'UNKNOWN'; }));
  } else {
    flushLogs_(ctx, m);
    failures.forEach(function (o) { sh.getRange(o.row, EMP_VIEW.RESULT_COL).setValue('❌ ' + o.msg); });
  }
  const okMsgs = outcomes.filter(function (o) { return o.ok; }).map(function (o) { return o.cycle.taskName + ': ' + o.msg; });
  const badMsgs = failures.map(function (o) { return '❌ ' + o.msg; });
  toast_(ctx, okMsgs.concat(badMsgs).join('  ·  '));
  return { handled: true, kind: 'COMPLETION', outcomes: outcomes };
}

/** After a re-render, put a rejected entry back on its (moved) row with the reason, so nothing typed is lost. */
function annotateEmployeeRows_(sh, failures) {
  if (!sh || !failures.length) return;
  const last = sh.getLastRow();
  if (last < EMP_VIEW.FIRST_ROW) return;
  const ids = sh.getRange(EMP_VIEW.FIRST_ROW, 1, last - EMP_VIEW.FIRST_ROW + 1, 1).getValues().map(function (r) { return String(r[0]); });
  failures.forEach(function (o) {
    const i = o.id ? ids.indexOf(o.id) : -1;
    if (i < 0) return;
    const r = EMP_VIEW.FIRST_ROW + i;
    sh.getRange(r, EMP_VIEW.INPUT_COL, 1, 2).setValues([[String(o.input), '❌ ' + o.msg]]);
  });
}

function sectionAt_(colA, row) {
  const titles = [DASH.TITLE_OVERVIEW, DASH.TITLE_ATTENTION, DASH.TITLE_OPEN, DASH.TITLE_RECENT];
  for (let r = row; r >= 1; r--) {
    const v = String(colA[r - 1] || '');
    for (let i = 0; i < titles.length; i++) if (v.indexOf(titles[i]) === 0) return titles[i];
  }
  return '';
}

function handleDashboardEdit_(ctx, e, sh) {
  const r0 = e.range.getRow();
  const c0 = e.range.getColumn();
  const nr = e.range.getNumRows();
  const nc = e.range.getNumColumns();
  const touches = function (col) { return c0 <= col && col <= c0 + nc - 1; };
  if (!touches(DASH.ACK_COL) && !touches(DASH.NOTE_COL) && !touches(DASH.ACTION_COL)) return { handled: false, reason: 'not an editable column' };

  const titles = sh.getRange(1, TITLE_COL, r0 + nr - 1, 1).getValues().map(function (r) { return r[0]; });
  const block = sh.getRange(r0, 1, nr, DASH.WIDTH).getValues();
  const m = loadModel_(ctx);
  const actor = actorFromEvent_(e, null) || 'Manager (dashboard)';
  const outcomes = [];
  const touched = [];
  let changed = false;

  block.forEach(function (row, i) {
    if (sectionAt_(titles, r0 + i) !== DASH.TITLE_ATTENTION) return;
    const c = m.byId[String(row[0] || '').trim()];
    if (!c) return;
    touched.push(c.employee);
    const note = row[DASH.NOTE_COL - 1];
    if (touches(DASH.NOTE_COL) && !touches(DASH.ACK_COL)) {
      if (saveNote_(m, c, actor, note)) changed = true;
    }
    if (touches(DASH.ACK_COL)) {
      if (row[DASH.ACK_COL - 1] === true) {
        const res = ackCycle_(m, c, actor, note);
        outcomes.push(Object.assign({ id: c.id, action: 'ACK' }, res));
        if (res.ok) changed = true;
      } else if (c.ackAt) {
        outcomes.push({ id: c.id, action: 'UNACK', ok: false, msg: 'An acknowledgement is a record and cannot be withdrawn.' });
        changed = true; // re-render restores the tick
      } else {
        changed = true; // stray edit on a read-only cell: re-render restores it
      }
    }
    if (touches(DASH.ACTION_COL) && String(row[DASH.ACTION_COL - 1]).trim() === ACTION_WAIVE) {
      const res = waiveCycle_(m, c, actor, note);
      outcomes.push(Object.assign({ id: c.id, action: 'WAIVE' }, res));
      changed = true;
    }
  });
  if (!changed && !outcomes.length) return { handled: false, reason: 'no actionable rows' };
  saveModel_(ctx, m);
  renderAll_(ctx, m, uniq_(touched));
  toast_(ctx, outcomes.map(function (o) { return (o.ok ? '✅ ' : '❌ ') + o.id + ': ' + o.msg; }).join('  ·  ') || 'Saved.');
  return { handled: true, kind: 'DASHBOARD', outcomes: outcomes };
}


// ===== 09_WebApp.js =====
/**
 * 09_WebApp — one-click acknowledgement from the manager-alert email.
 * GET only renders a confirmation page (email link scanners can't acknowledge on the manager's behalf);
 * the Confirm button calls confirmAck() via google.script.run. Links are HMAC-signed per cycle.
 * Spec: specs/features/F06-manager-dashboard-and-ack.md
 */

function ackSecret_() {
  const props = PropertiesService.getScriptProperties();
  let s = props.getProperty('ACK_SECRET');
  if (!s) {
    s = Utilities.getUuid() + Utilities.getUuid();
    props.setProperty('ACK_SECRET', s);
  }
  return s;
}

function signId_(id) {
  const raw = Utilities.computeHmacSha256Signature(String(id), ackSecret_());
  return Utilities.base64EncodeWebSafe(raw).replace(/=+$/, '');
}

function verifySig_(id, sig) {
  if (!id || !sig) return false;
  const expected = signId_(id);
  sig = String(sig);
  if (expected.length !== sig.length) return false;
  let diff = 0;
  for (let i = 0; i < expected.length; i++) diff |= expected.charCodeAt(i) ^ sig.charCodeAt(i);
  return diff === 0;
}

function webAppBaseUrl_(ctx, m) {
  if (ctx.webAppUrl) return ctx.webAppUrl;
  if (m.cfg.webAppUrl) return m.cfg.webAppUrl;
  if (m._autoUrl === undefined) {
    try { m._autoUrl = ScriptApp.getService().getUrl() || ''; } catch (e) { m._autoUrl = ''; }
  }
  return m._autoUrl;
}

function ackUrl_(ctx, m, id) {
  const base = webAppBaseUrl_(ctx, m);
  if (!base) return '';
  return base + (base.indexOf('?') >= 0 ? '&' : '?') + 'a=ack&c=' + encodeURIComponent(id) + '&s=' + signId_(id);
}

function hostSpreadsheet_() {
  let ss = null;
  try { ss = SpreadsheetApp.getActiveSpreadsheet(); } catch (e) { ss = null; }
  if (ss) return ss;
  const id = PropertiesService.getScriptProperties().getProperty('SPREADSHEET_ID');
  if (!id) throw new Error('Spreadsheet not registered. Open the sheet and run Setup once.');
  return SpreadsheetApp.openById(id);
}

/* ───────────── page rendering ───────────── */

/** JSON string literal that is also safe inside an inline <script>. */
function jsString_(s) {
  return JSON.stringify(String(s)).replace(/</g, '\\u003c').replace(/>/g, '\\u003e');
}

function ackPageHtml_(title, bodyHtml) {
  return '<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">' +
    '<title>' + escapeHtml_(title) + '</title><style>' +
    ':root{color-scheme:light dark;--ink:#1f2933;--muted:#5f6b7a;--line:#e5e7eb;--bg:#f4f5f7;--card:#ffffff;--accent:#1f2933;--on-accent:#ffffff;--ok:#15803d;--bad:#b42318;--warn-bg:#fff4e5}' +
    '@media (prefers-color-scheme: dark){:root{--ink:#e7eaee;--muted:#a3adb9;--line:#353c45;--bg:#0f1216;--card:#191e24;--accent:#e7eaee;--on-accent:#111418;--ok:#4ade80;--bad:#f87171;--warn-bg:#2a2216}}' +
    '*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 -apple-system,"Segoe UI",Roboto,Arial,sans-serif}' +
    '.wrap{max-width:560px;margin:0 auto;padding:24px 16px 40px}.card{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:22px}' +
    '.label{font-size:13px;font-weight:600;color:var(--muted);margin:0 0 4px}h1{font-size:22px;line-height:1.3;margin:0 0 16px}' +
    'dl{display:grid;grid-template-columns:auto 1fr;gap:6px 16px;margin:0 0 18px}dt{color:var(--muted)}dd{margin:0;font-weight:600}' +
    '.deadline{background:var(--warn-bg);border-radius:8px;padding:10px 12px;margin:0 0 18px;font-size:15px}' +
    'label{display:block;font-size:14px;color:var(--muted);margin-bottom:6px}textarea{width:100%;min-height:96px;padding:10px;border:1px solid var(--line);' +
    'border-radius:8px;background:transparent;color:inherit;font:inherit}textarea:focus{outline:2px solid var(--accent);outline-offset:1px}' +
    'button{margin-top:14px;width:100%;min-height:48px;padding:12px 16px;border:0;border-radius:8px;background:var(--accent);color:var(--on-accent);' +
    'font:inherit;font-weight:600;line-height:1.2;cursor:pointer}button:focus-visible{outline:3px solid var(--muted);outline-offset:2px}' +
    'button:disabled{opacity:.6;cursor:progress}.msg{margin-top:14px;font-weight:600;min-height:1.5em}.ok{color:var(--ok)}.bad{color:var(--bad)}' +
    '.note{color:var(--muted);font-size:14px;margin:16px 0 0}' +
    '</style></head><body><main class="wrap"><div class="card">' + bodyHtml +
    '</div><p class="note" style="text-align:center">' + escapeHtml_(APP_NAME) + '</p></main></body></html>';
}

function simplePage_(title, heading, text) {
  return { title: title, html: ackPageHtml_(title, '<h1>' + escapeHtml_(heading) + '</h1><p>' + escapeHtml_(text) + '</p>') };
}

/** Pure: builds the page for a GET. Never changes state (email link scanners must not acknowledge). */
function doGetCore_(ctx, params) {
  params = params || {};
  if (params.a !== 'ack') return simplePage_(APP_NAME, 'Nothing to do here', 'Open the spreadsheet to see your tasks.');
  const id = String(params.c || '');
  const sig = String(params.s || '');
  if (!verifySig_(id, sig)) {
    return simplePage_('Link not valid', 'This link is not valid',
      'It may have been changed or copied incompletely. Please acknowledge from the Manager Dashboard instead.');
  }
  const m = loadModel_(ctx);
  const c = m.byId[id];
  if (!c) return simplePage_('Task not found', 'This task could not be found', 'It may have been removed. Please check the Manager Dashboard.');

  const isOpen = c.status === STATUS.OPEN;
  const details = '<dl><dt>Employee</dt><dd>' + escapeHtml_(c.employee) + '</dd>' +
    '<dt>Cut-off</dt><dd>' + escapeHtml_(fmtLong_(c.dueAt)) + '</dd>' +
    '<dt>Task status</dt><dd>' + escapeHtml_(isOpen ? 'Still open — overdue by ' + durationText_(m.now - c.dueAt) : statusLabel_(c.status)) + '</dd>' +
    (c.ackAt ? '<dt>Acknowledged</dt><dd>' + escapeHtml_(fmtShort_(c.ackAt) + ' by ' + c.ackBy) + '</dd>' : '') + '</dl>';
  const heading = '<p class="label">' + (c.ackAt ? 'Acknowledged' : 'Acknowledge pending task') + '</p>' +
    '<h1>' + escapeHtml_(c.employee + ': ' + c.taskName) + '</h1>';

  if (!isOpen && !c.ackAt) {
    return {
      title: 'Already completed',
      html: ackPageHtml_('Already completed', '<p class="label">Nothing to do</p><h1>' + escapeHtml_(c.employee + ': ' + c.taskName) +
        '</h1>' + details + '<p>This task is already closed, so no acknowledgement is needed.</p>'),
    };
  }
  const deadline = isOpen
    ? '<p class="deadline">Make sure it is done by <b>' + escapeHtml_(fmtShort_(resolveDeadline_(c.dueAt, m.cfg))) +
      '</b>. If it is not, leadership is informed automatically.</p>'
    : '';
  const form = '<label for="note">' + (c.ackAt ? 'Update your note' : 'Note for the record (optional): the reason, or when it will be done') + '</label>' +
    '<textarea id="note" maxlength="500">' + escapeHtml_(c.ackNote) + '</textarea>' +
    '<button id="go" type="button">' + (c.ackAt ? 'Save note' : 'Confirm acknowledgement') + '</button>' +
    '<div id="msg" class="msg" role="status" aria-live="polite"></div>' +
    '<script>(function(){var b=document.getElementById("go"),m=document.getElementById("msg");b.onclick=function(){b.disabled=true;m.className="msg";m.textContent="Saving…";' +
    'google.script.run.withSuccessHandler(function(r){m.className="msg "+(r.ok?"ok":"bad");m.textContent=r.msg;b.disabled=false;})' +
    '.withFailureHandler(function(){m.className="msg bad";m.textContent="Could not save. Please try again, or tick ✅ Ack on the Manager Dashboard.";b.disabled=false;})' +
    '.confirmAck(' + jsString_(id) + ',' + jsString_(sig) + ',document.getElementById("note").value);};})();</script>';
  return { title: 'Acknowledge: ' + c.taskName, html: ackPageHtml_('Acknowledge', heading + details + deadline + form) };
}

/** State change for the Confirm button. Same code path as the dashboard tick. */
function confirmAckCore_(ctx, id, sig, note) {
  if (!verifySig_(id, sig)) return { ok: false, msg: 'This link is not valid.' };
  const m = loadModel_(ctx);
  const c = m.byId[String(id)];
  if (!c) return { ok: false, msg: 'This task could not be found.' };
  let actor = '';
  try { actor = Session.getActiveUser().getEmail(); } catch (e) { actor = ''; }
  actor = actor ? actor.toLowerCase() + ' (email link)' : 'Manager (email link)';
  const res = ackCycle_(m, c, actor, note);
  if (res.ok) {
    saveModel_(ctx, m);
    renderAll_(ctx, m, []);
  }
  return { ok: res.ok, msg: res.msg };
}


// ===== 10_Setup.js =====
/**
 * 10_Setup — builds / repairs the spreadsheet non-destructively, seeds the demo scenario,
 * installs triggers. Safe to run any number of times (spec F09).
 */

const CONFIG_HEADERS = ['Key', 'Value', 'Description', 'Status'];

function setupSystem_(ss, opts) {
  opts = opts || {};
  try { ss.setSpreadsheetTimeZone(Session.getScriptTimeZone()); } catch (e) { /* not fatal */ }

  ensureStartSheet_(ss);
  ensureConfigSheet_(ss);
  const team = ensureTableSheet_(ss, SHEETS.TEAM, TEAM_FIELDS.map(function (f) { return f[1]; }));
  const tasks = ensureTableSheet_(ss, SHEETS.TASKS, TASK_FIELDS.map(function (f) { return f[1]; }));
  const cycles = ensureTableSheet_(ss, SHEETS.CYCLES, CYCLE_FIELDS.map(function (f) { return f[1]; }));
  ensureTableSheet_(ss, SHEETS.LOG, LOG_HEADERS);
  ensureTableSheet_(ss, SHEETS.EMAILS, EMAIL_HEADERS);
  ensureTableSheet_(ss, SHEETS.TESTS, TEST_HEADERS);

  if (opts.seed !== false && team.getLastRow() < 2 && tasks.getLastRow() < 2) {
    seedDemo_(ss, opts.now || new Date());
  }
  formatTeam_(team);
  formatTasks_(ss, tasks, team);
  formatCycles_(cycles);
  formatLogs_(ss);

  if (!ss.getSheetByName(SHEETS.DASHBOARD)) styleDashboard_(ss.insertSheet(SHEETS.DASHBOARD));
  const stray = ss.getSheetByName('Sheet1');
  if (stray && stray.getLastRow() === 0 && ss.getSheets().length > 1) ss.deleteSheet(stray);
  orderSheets_(ss);
}

function ensureTableSheet_(ss, name, headers) {
  let sh = ss.getSheetByName(name);
  if (!sh) sh = ss.insertSheet(name);
  ensureCols_(sh, headers.length);
  const lastCol = sh.getLastColumn();
  const existing = lastCol ? sh.getRange(1, 1, 1, lastCol).getValues()[0].map(function (h) { return String(h).trim(); }) : [];
  const nonEmpty = existing.filter(Boolean).length;
  if (!nonEmpty) {
    sh.getRange(1, 1, 1, headers.length).setValues([headers]);
  } else {
    const missing = headers.filter(function (h) { return existing.indexOf(h) < 0; });
    if (missing.length) {
      ensureCols_(sh, lastCol + missing.length);
      sh.getRange(1, lastCol + 1, 1, missing.length).setValues([missing]);
    }
  }
  const width = Math.max(sh.getLastColumn(), headers.length);
  sh.getRange(1, 1, 1, width).setFontWeight('bold').setBackground(COLORS.HEADER_BG);
  sh.setFrozenRows(1);
  return sh;
}

function ensureConfigSheet_(ss) {
  const sh = ensureTableSheet_(ss, SHEETS.CONFIG, CONFIG_HEADERS);
  ensureRows_(sh, CONFIG_SPEC.length + 5);
  sh.getRange(2, 2, sh.getMaxRows() - 1, 1).setNumberFormat(FMT.TEXT);
  const last = sh.getLastRow();
  const keys = last >= 2 ? sh.getRange(2, 1, last - 1, 1).getValues().map(function (r) { return String(r[0]).trim(); }) : [];
  const add = CONFIG_SPEC.filter(function (s) { return keys.indexOf(s[0]) < 0; }).map(function (s) { return [s[0], s[1], s[2], '']; });
  appendRows_(sh, add, 4);
  [230, 330, 560, 380].forEach(function (w, i) { sh.setColumnWidth(i + 1, w); });
  sh.getRange(2, 3, sh.getMaxRows() - 1, 2).setWrap(true).setFontColor(COLORS.MUTED);
  return sh;
}

/** Writes a ✅ / ⚠️ status next to each config key. */
function writeConfigStatus_(ctx) {
  const sh = ctx.ss.getSheetByName(SHEETS.CONFIG);
  if (!sh || sh.getLastRow() < 2) return;
  const n = sh.getLastRow() - 1;
  const keys = sh.getRange(2, 1, n, 1).getValues().map(function (r) { return String(r[0]).trim(); });
  const errors = ctx.cfg.errors;
  const out = keys.map(function (k) {
    if (!k) return [''];
    const e = errors.filter(function (x) { return x.indexOf(k + ' ') === 0 || x.indexOf(k + ' "') === 0; });
    return [e.length ? '⚠️ ' + e.join('; ') : '✅ OK'];
  });
  sh.getRange(2, 4, n, 1).setValues(out);
}

/**
 * insertCheckboxes() resets values to FALSE, so existing values are read first and written back.
 * Blank cells stay blank (an unchecked box with no value) so getLastRow() is not pushed down.
 */
function checkboxColumn_(sh, col, rows) {
  ensureRows_(sh, rows + 1);
  const rng = sh.getRange(2, col, rows, 1);
  const keep = rng.getValues().map(function (r) { return [r[0] === '' || r[0] === null ? '' : (r[0] === true || toBool_(r[0]))]; });
  rng.insertCheckboxes();
  rng.setValues(keep);
}

function formatTeam_(sh) {
  const idx = headerIndex_(sh);
  [170, 240, 240, 80, 300].forEach(function (w, i) { sh.setColumnWidth(i + 1, w); });
  if (idx['Active']) checkboxColumn_(sh, idx['Active'], 200);
  ['Email', 'Manager Email', 'Employee'].forEach(function (h) {
    if (idx[h]) sh.getRange(2, idx[h], 200, 1).setNumberFormat(FMT.TEXT);
  });
}

function formatTasks_(ss, sh, team) {
  const idx = headerIndex_(sh);
  [80, 230, 150, 130, 120, 380, 90, 130, 70, 380].forEach(function (w, i) { sh.setColumnWidth(i + 1, w); });
  const rows = 300;
  ensureRows_(sh, rows + 1);
  if (idx['Task ID']) sh.getRange(2, idx['Task ID'], rows, 1).setNumberFormat(FMT.TEXT);
  if (idx['Due Time']) sh.getRange(2, idx['Due Time'], rows, 1).setNumberFormat(FMT.TEXT);
  if (idx['First Due Date']) sh.getRange(2, idx['First Due Date'], rows, 1).setNumberFormat(FMT.DATE);
  if (idx['Frequency']) {
    sh.getRange(2, idx['Frequency'], rows, 1).setDataValidation(SpreadsheetApp.newDataValidation()
      .requireValueInList(FREQUENCY_OPTIONS, true).setAllowInvalid(true)
      .setHelpText('Daily, or "Every N days" (any N from 2 to 366).').build());
  }
  if (idx['Proof Type']) {
    sh.getRange(2, idx['Proof Type'], rows, 1).setDataValidation(SpreadsheetApp.newDataValidation()
      .requireValueInList([PROOF.TICKET, PROOF.DAILY], true).setAllowInvalid(false).build());
  }
  if (idx['Assigned To']) {
    sh.getRange(2, idx['Assigned To'], rows, 1).setDataValidation(SpreadsheetApp.newDataValidation()
      .requireValueInRange(team.getRange(2, 1, 200, 1), true).setAllowInvalid(true).build());
  }
  if (idx['Active']) checkboxColumn_(sh, idx['Active'], rows);
  if (idx['Health']) sh.getRange(2, idx['Health'], rows, 1).setFontColor(COLORS.MUTED).setWrap(true);
  sh.getRange(2, 1, rows, sh.getLastColumn()).setVerticalAlignment('top');
  if (idx['Instructions']) sh.getRange(2, idx['Instructions'], rows, 1).setWrap(true);
}

function formatCycles_(sh) {
  const idx = headerIndex_(sh);
  const rows = Math.max(sh.getMaxRows() - 1, 1);
  CYCLE_FIELDS.forEach(function (f) {
    const col = idx[f[1]];
    if (!col) return;
    let fm = FMT.TEXT;
    if (f[0] === 'slot') fm = FMT.DATE;
    else if (CYCLE_DATE_KEYS.indexOf(f[0]) >= 0) fm = FMT.LEDGER_DT;
    sh.getRange(2, col, rows, 1).setNumberFormat(fm);
  });
  sh.setTabColor('#9ca3af');
}

function formatLogs_(ss) {
  [SHEETS.LOG, SHEETS.EMAILS, SHEETS.TESTS].forEach(function (n) {
    const sh = ss.getSheetByName(n);
    if (!sh) return;
    const rows = Math.max(sh.getMaxRows() - 1, 1);
    sh.getRange(2, 1, rows, 1).setNumberFormat(FMT.LEDGER_DT);
    // Text columns may carry user input (proof, notes): plain text so '=…' is never evaluated.
    if (n !== SHEETS.TESTS) sh.getRange(2, 2, rows, Math.max(sh.getLastColumn() - 1, 1)).setNumberFormat(FMT.TEXT);
    sh.setTabColor('#9ca3af');
  });
  const t = ss.getSheetByName(SHEETS.TESTS);
  if (t) { [60, 330, 80, 700, 110, 150].forEach(function (w, i) { t.setColumnWidth(i + 1, w); }); }
  const l = ss.getSheetByName(SHEETS.LOG);
  if (l) { [150, 170, 150, 230, 520].forEach(function (w, i) { l.setColumnWidth(i + 1, w); }); }
}

function headerIndex_(sh) {
  const lastCol = sh.getLastColumn();
  const out = {};
  if (!lastCol) return out;
  sh.getRange(1, 1, 1, lastCol).getValues()[0].forEach(function (h, i) { if (h !== '') out[String(h).trim()] = i + 1; });
  return out;
}

function ensureStartSheet_(ss) {
  let sh = ss.getSheetByName(SHEETS.START);
  if (!sh) sh = ss.insertSheet(SHEETS.START, 0);
  const lines = [
    ['Allo Recurring Tasks — start here'],
    [''],
    ['EMPLOYEES'],
    ['Open your own tab (👤 Your Name). Everything you need to act on is under ACTION NEEDED.'],
    ['When a task is done, type the Ticket ID (portal tasks) or paste the update you shared on WhatsApp (daily task) into the yellow cell and press Enter. That one entry is the whole update: the system records who and when, closes the task and schedules the next cycle.'],
    ['If the Result column shows ❌, read the reason, fix the entry and press Enter again.'],
    [''],
    ['MANAGER'],
    ['Manager Dashboard shows who is behind. If a task misses its cut-off you get ONE email the same day (cut-off + 30 min).'],
    ['Then: (1) check with the employee, (2) acknowledge by 11:00 the next working day (email link, or tick ✅ on the dashboard with a note), (3) get it done by the cut-off time on the next working day, or choose Waive if the person is on leave or it is a holiday.'],
    ['If you do not acknowledge, or the task is still open after that, leadership is emailed automatically (once).'],
    [''],
    ['ADMIN'],
    ['Tasks = the Task Master (add, change or deactivate recurring tasks). Team = people and their managers. Config = SLA times, email recipients and EMAIL_MODE (LOG_ONLY / LIVE).'],
    ['Menu ⚙️ Task System → Admin → Install triggers (once). The engine then runs every 15 minutes and edits are processed instantly.'],
    ['Demo: ⚙️ Task System → Demo clock moves a simulated time forward so you can watch reminders, alerts and escalations happen. Use "Back to real time" when finished.'],
    ['Proof of correctness: ⚙️ Task System → Automated tests writes PASS/FAIL with evidence to the Test Results sheet. Tests run on a throw-away copy, so your data is never touched.'],
    [''],
    ['System sheets (do not edit by hand): Cycles (ledger), Activity Log (audit trail), Email Log (every email), Test Results.'],
  ];
  ensureRows_(sh, lines.length + 1);
  sh.getRange(1, 1, lines.length, 1).setValues(lines);
  sh.setColumnWidth(1, 980);
  sh.getRange(1, 1, lines.length, 1).setWrap(true).setVerticalAlignment('top');
  sh.getRange(1, 1).setFontSize(16).setFontWeight('bold');
  [3, 8, 13].forEach(function (r) { sh.getRange(r, 1).setFontWeight('bold').setBackground(COLORS.SECTION_BG); });
  sh.setHiddenGridlines(true);
  return sh;
}

function seedDemo_(ss, now) {
  const base = startOfDay_(now);
  const team = ss.getSheetByName(SHEETS.TEAM);
  const tasks = ss.getSheetByName(SHEETS.TASKS);
  const teamRows = [
    ['Employee A', 'employee.a@example.com', '', true, 'Owns the daily operations update'],
    ['Employee B', 'employee.b@example.com', '', true, ''],
    ['Employee C', 'employee.c@example.com', '', true, ''],
    ['Employee D', 'employee.d@example.com', '', true, ''],
  ];
  const portal = 'Complete the task on the portal and update the ticket, then enter the Ticket ID here.';
  const taskRows = [
    ['T01', 'Daily Operations Update', 'Employee A', 'Daily', PROOF.DAILY,
      'Post today\'s operations update in the Ops WhatsApp group, then paste the same text here.', '18:00', base, true, ''],
    ['T02', 'Portal Task A', 'Employee B', 'Every 7 days', PROOF.TICKET, portal, '18:00', base, true, ''],
    ['T03', 'Portal Task B', 'Employee C', 'Every 15 days', PROOF.TICKET, portal, '18:00', addDays_(base, 2), true, ''],
    ['T04', 'Portal Task C', 'Employee D', 'Every 30 days', PROOF.TICKET, portal, '18:00', addDays_(base, 5), true, ''],
  ];
  writeTableRows_(team, TEAM_FIELDS, teamRows);
  writeTableRows_(tasks, TASK_FIELDS, taskRows);
}

/** Writes rows given in *_FIELDS order into whatever column order the sheet actually has. */
function writeTableRows_(sh, fields, rows) {
  if (!rows.length) return;
  const idx = headerIndex_(sh);
  const width = sh.getLastColumn();
  const out = rows.map(function (r) {
    const line = [];
    for (let i = 0; i < width; i++) line.push('');
    fields.forEach(function (f, i) { if (idx[f[1]]) line[idx[f[1]] - 1] = r[i] === undefined || r[i] === null ? '' : r[i]; });
    return line;
  });
  const start = sh.getLastRow() + 1;
  ensureRows_(sh, start + out.length);
  sh.getRange(start, 1, out.length, width).setValues(out);
}

function clearDataRows_(sh) {
  if (!sh) return;
  const last = sh.getLastRow();
  if (last >= 2) sh.getRange(2, 1, last - 1, Math.max(1, sh.getLastColumn())).clearContent();
}

function resetDemoData_(ss, now) {
  [SHEETS.TEAM, SHEETS.TASKS, SHEETS.CYCLES, SHEETS.LOG, SHEETS.EMAILS].forEach(function (n) { clearDataRows_(ss.getSheetByName(n)); });
  ss.getSheets().forEach(function (sh) { if (sh.getName().indexOf(EMPLOYEE_TAB_PREFIX) === 0) ss.deleteSheet(sh); });
  seedDemo_(ss, now);
}

function orderSheets_(ss) {
  const order = [SHEETS.START, SHEETS.DASHBOARD];
  ss.getSheets().forEach(function (sh) { if (sh.getName().indexOf(EMPLOYEE_TAB_PREFIX) === 0) order.push(sh.getName()); });
  order.push(SHEETS.TASKS, SHEETS.TEAM, SHEETS.CONFIG, SHEETS.CYCLES, SHEETS.LOG, SHEETS.EMAILS, SHEETS.TESTS);
  let pos = 1;
  order.forEach(function (n) {
    const sh = ss.getSheetByName(n);
    if (!sh) return;
    ss.setActiveSheet(sh);
    ss.moveActiveSheet(pos++);
  });
  const start = ss.getSheetByName(SHEETS.START);
  if (start) ss.setActiveSheet(start);
}

function installTriggers_(ss) {
  const handlers = ['runEngine', 'handleEdit'];
  ScriptApp.getProjectTriggers().forEach(function (t) {
    if (handlers.indexOf(t.getHandlerFunction()) >= 0) ScriptApp.deleteTrigger(t);
  });
  ScriptApp.newTrigger('runEngine').timeBased().everyMinutes(15).create();
  ScriptApp.newTrigger('handleEdit').forSpreadsheet(ss).onEdit().create();
}


// ===== 11_Main.js =====
/**
 * 11_Main — entry points (triggers, menu, web app). Thin wrappers: lock → context → *Core_.
 * Public names (no trailing underscore) are what Apps Script triggers and the menu call.
 */

const MENU_NAME = '⚙️ Task System';

function withLock_(fn, waitMs) {
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(waitMs || 25000)) return { skipped: true, reason: 'busy' };
  try {
    return fn();
  } finally {
    lock.releaseLock();
  }
}

function safeUi_() {
  try { return SpreadsheetApp.getUi(); } catch (e) { return null; }
}

function alert_(msg) {
  const ui = safeUi_();
  if (ui) ui.alert(APP_NAME, msg, ui.ButtonSet.OK);
  else console.log(msg);
}

/* ───────────── core engine run ───────────── */

function runEngineCore_(ctx, opts) {
  opts = opts || {};
  const m = loadModel_(ctx);
  ensureCycles_(m);
  processNotifications_(ctx, m);
  saveModel_(ctx, m);
  writeConfigStatus_(ctx);
  PropertiesService.getScriptProperties().setProperty(lastRunKey_(ctx.ss), fmtShort_(m.now));
  if (opts.render !== false) renderAll_(ctx, m);
  const live = liveCycles_(m);
  return {
    cycles: live.length,
    open: live.filter(function (c) { return c.status === STATUS.OPEN; }).length,
    emailsSent: m.emailsSent || 0,
    warnings: uniq_(m.warnings),
  };
}

/* ───────────── triggers ───────────── */

/** Time-driven trigger (every 15 min) and menu "Run engine now". */
function runEngine() {
  return withLock_(function () {
    const ss = hostSpreadsheet_();
    return runEngineCore_(makeContext_(ss), { render: true });
  });
}

/** Installable onEdit trigger (created by installTriggers). Not named onEdit on purpose: no double firing. */
function handleEdit(e) {
  if (!e || !e.range) return;
  const ss = e.source || hostSpreadsheet_();
  const res = withLock_(function () {
    try {
      return handleEditCore_(makeContext_(ss), e);
    } catch (err) {
      console.error(err && err.stack ? err.stack : err);
      reportEditError_(ss, e, 'Something went wrong: ' + (err && err.message ? err.message : err) + '. Please try again or tell the admin.');
      return { handled: false, error: String(err) };
    }
  });
  if (res && res.skipped) reportEditError_(ss, e, '⏳ The system was busy. Please press Enter on the cell again in a moment.');
}

function reportEditError_(ss, e, msg) {
  try {
    const sh = e.range.getSheet();
    if (sh.getName().indexOf(EMPLOYEE_TAB_PREFIX) === 0 && e.range.getRow() >= EMP_VIEW.FIRST_ROW) {
      sh.getRange(e.range.getRow(), EMP_VIEW.RESULT_COL).setValue(msg);
    }
    ss.toast(msg, APP_NAME, 8);
  } catch (x) { /* best effort */ }
}

/** Simple trigger: only builds the menu (simple triggers cannot do authorised work). */
function onOpen() {
  const ui = safeUi_();
  if (!ui) return;
  ui.createMenu(MENU_NAME)
    .addItem('▶ Run engine now', 'menuRunEngine')
    .addSubMenu(ui.createMenu('⏱ Demo clock')
      .addItem('Start of demo day (10:00 today, or next working day)', 'menuClockToday10')
      .addItem('+1 hour', 'menuClockPlus1h')
      .addItem('+3 hours', 'menuClockPlus3h')
      .addItem('+1 day', 'menuClockPlus1d')
      .addSeparator()
      .addItem('Jump to manager-alert time (cut-off + grace)', 'menuClockAlert')
      .addItem('Jump to ack deadline (next working day)', 'menuClockAckDeadline')
      .addItem('Jump to next cut-off + 1 min (resolve deadline)', 'menuClockResolveDeadline')
      .addSeparator()
      .addItem('Back to real time', 'menuClockReal'))
    .addSubMenu(ui.createMenu('🧪 Automated tests')
      .addItem('Run core tests (T1–T8)', 'menuTestsCore')
      .addItem('Run robustness tests (B01–B22)', 'menuTestsBreak')
      .addItem('Run all tests', 'menuTestsAll'))
    .addSeparator()
    .addSubMenu(ui.createMenu('🛠 Admin')
      .addItem('Setup / repair sheets', 'setupSystem')
      .addItem('Install triggers', 'installTriggers')
      .addItem('Reset demo data (sets demo clock)', 'menuResetDemo'))
    .addToUi();
}

/* ───────────── menu actions ───────────── */

function menuRunEngine() {
  const res = runEngine();
  if (res && res.skipped) return alert_('The engine is already running. Try again in a few seconds.');
  hostSpreadsheet_().toast('Engine ran · ' + res.open + ' open · ' + res.emailsSent + ' email batch(es)', APP_NAME, 5);
}

/** One-time install: builds sheets, registers the spreadsheet for the web app, renders views. */
function setupSystem() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  withLock_(function () {
    setupSystem_(ss, { seed: true });
    PropertiesService.getScriptProperties().setProperty('SPREADSHEET_ID', ss.getId());
    ackSecret_();
    runEngineCore_(makeContext_(ss), { render: true });
    orderSheets_(ss);
  });
  onOpen();
  alert_('Setup complete.\n\nNext: ⚙️ Task System → Admin → Install triggers.\n' +
    'Emails are in LOG_ONLY mode (see Email Log). Put real addresses in Team/Config and set EMAIL_MODE = LIVE to send them.');
}

function installTriggers() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  installTriggers_(ss);
  alert_('Triggers installed: engine every 15 minutes, edits processed instantly.');
}

function menuResetDemo() {
  const ui = safeUi_();
  if (ui) {
    const ok = ui.alert(APP_NAME, 'Reset Team, Tasks, Cycles and logs to the demo scenario? This deletes current data.', ui.ButtonSet.YES_NO);
    if (ok !== ui.Button.YES) return;
  }
  const ss = hostSpreadsheet_();
  const res = withLock_(function () {
    const start = demoStart_(readConfig_(ss));
    resetDemoData_(ss, start);
    setDemoClock_(ss, start);
    runEngineCore_(makeContext_(ss), { render: true });
    orderSheets_(ss);
    return { start: start };
  });
  if (res && res.skipped) return alert_('The engine is busy. Try again in a few seconds.');
  ss.toast('Demo data loaded. Demo clock set to ' + fmtLong_(res.start) + '. Use Demo clock → Back to real time when finished.', APP_NAME, 8);
}

/* Demo clock: moves Config.SIMULATED_NOW and runs the engine so time-based behaviour can be shown live. */

function setDemoClock_(ss, d) {
  const sh = requireSheet_(ss, SHEETS.CONFIG);
  const last = sh.getLastRow();
  const keys = sh.getRange(2, 1, Math.max(last - 1, 1), 1).getValues().map(function (r) { return String(r[0]).trim(); });
  const i = keys.indexOf('SIMULATED_NOW');
  if (i < 0) throw new Error('SIMULATED_NOW is missing from Config. Run Setup.');
  sh.getRange(i + 2, 2).setValue(d ? fmt_(d, 'yyyy-MM-dd HH:mm') : '');
}

function moveDemoClock_(fn) {
  const ss = hostSpreadsheet_();
  const res = withLock_(function () {
    const cfg = readConfig_(ss);
    const current = cfg.simulatedNow || new Date();
    const next = fn(current, cfg);
    setDemoClock_(ss, next);
    return { next: next, run: runEngineCore_(makeContext_(ss), { render: true }) };
  });
  if (res && res.skipped) return alert_('The engine is busy. Try again in a few seconds.');
  ss.toast((res.next ? 'Demo clock: ' + fmtLong_(res.next) : 'Back to real time') + ' · ' + res.run.emailsSent + ' email batch(es) this run', APP_NAME, 6);
}

/** 10:00 today, or on the next working day if today is a weekend/holiday (otherwise nothing would be due). */
function demoStart_(cfg) {
  return atTime_(onOrNextWorkingDay_(new Date(), cfg), { h: 10, m: 0 });
}

function menuClockToday10() { moveDemoClock_(function (d, cfg) { return demoStart_(cfg); }); }
function menuClockPlus1h() { moveDemoClock_(function (d) { return addMinutes_(d, 60); }); }
function menuClockPlus3h() { moveDemoClock_(function (d) { return addMinutes_(d, 180); }); }
function menuClockPlus1d() { moveDemoClock_(function (d) { return addDays_(d, 1); }); }
function menuClockAlert() {
  moveDemoClock_(function (d, cfg) { return addMinutes_(atTime_(d, cfg.defaultDueHM), cfg.graceMin + 1); });
}
function menuClockAckDeadline() {
  moveDemoClock_(function (d, cfg) { return addMinutes_(atTime_(nextWorkingDay_(d, cfg), cfg.ackHM), 1); });
}
/** Next cut-off + 1 min: from Mon 18:31 → Tue 18:01, from Tue 11:01 → Tue 18:01 (= the resolve deadline). */
function menuClockResolveDeadline() {
  moveDemoClock_(function (d, cfg) {
    const today = addMinutes_(atTime_(d, cfg.defaultDueHM), 1);
    if (isWorkingDay_(d, cfg) && d.getTime() < today.getTime()) return today;
    return addMinutes_(atTime_(nextWorkingDay_(d, cfg), cfg.defaultDueHM), 1);
  });
}
function menuClockReal() { moveDemoClock_(function () { return null; }); }

function menuTestsCore() { runTestsToSheet_('core'); }
function menuTestsBreak() { runTestsToSheet_('break'); }
function menuTestsAll() { runTestsToSheet_('all'); }

/* ───────────── web app ───────────── */

function doGet(e) {
  const ss = hostSpreadsheet_();
  const page = doGetCore_(makeContext_(ss), e && e.parameter);
  return HtmlService.createHtmlOutput(page.html)
    .setTitle(page.title)
    .addMetaTag('viewport', 'width=device-width, initial-scale=1');
}

/** Called from the confirmation page via google.script.run. */
function confirmAck(id, sig, note) {
  const res = withLock_(function () {
    return confirmAckCore_(makeContext_(hostSpreadsheet_()), id, sig, note);
  });
  if (res && res.skipped) return { ok: false, msg: 'The system is busy — please press the button again.' };
  return res;
}


